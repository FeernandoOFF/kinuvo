---
// The eight avatars an Agent can wear, live from avatars.riv. They watch the pointer and react to it.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const avatars = ['Lilac Cloud', 'Tangerine Drop', 'Mint Pill', 'Coral Bloom', 'Sky Peak', 'Honey Star', 'Berry Orb', 'Cocoa Bloop'];
const still = (name: string) => `${base}avatars/avatar-${name.toLowerCase().replace(/ /g, '-')}-idle.png`;
---

<section class="k-crew">
  <h2>Give each Agent a name, a look and a Soul</h2>
  <p>Agents keep their own Identity, Soul, Memory and Skills. Their face tells you what they're doing: listening, working, or waiting on you.</p>
  <ul>
    {avatars.map((name) => (
      <li>
        <kinuvo-avatar artboard={name} pokeable><img src={still(name)} alt="" /></kinuvo-avatar>
        <span>{name}</span>
      </li>
    ))}
  </ul>
</section>

<script>
  import './avatar';
</script>

<style>
  .k-crew { text-align: center; padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  h2 { font-size: clamp(1.7rem, 3.4vw, 2.4rem); margin: 0; letter-spacing: -.02em; }
  p { color: var(--sl-color-gray-2); max-width: 54ch; margin: .75rem auto 0; line-height: 1.7; }
  ul { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(8, 1fr); gap: .5rem; }
  li { display: flex; flex-direction: column; align-items: center; gap: .35rem; margin: 0; }
  kinuvo-avatar { width: 100%; max-width: 112px; aspect-ratio: 1; cursor: pointer; transition: transform .25s cubic-bezier(.3, 1.6, .5, 1); }
  kinuvo-avatar:hover { transform: translateY(-6px); }
  span { font-size: .78rem; color: var(--sl-color-gray-3); opacity: 0; transition: opacity .2s ease; }
  li:hover span { opacity: 1; }
  @media (max-width: 40rem) { ul { grid-template-columns: repeat(4, 1fr); row-gap: 1rem; } span { opacity: 1; } }
</style>
