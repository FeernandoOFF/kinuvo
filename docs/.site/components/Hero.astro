  .ob-device .ob-next { flex-shrink: 0; margin: 0 1.1rem 1.2rem; padding: .85rem; border: 0; border-radius: 999px; cursor: pointer; background: #1f1e1b; color: #faf9f5; font: 600 .95rem Libron, Georgia, serif; transition: transform .2s ease, background .3s; }
