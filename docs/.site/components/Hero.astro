  .ob h1 { margin: 0; font-family: Libron, Georgia, serif; font-weight: 400; font-size: clamp(3rem, 6.4vw, 5.4rem); line-height: .98; letter-spacing: -.045em; color: var(--sl-color-white); }
  .ob h2 { margin: 0; font-family: Libron, Georgia, serif; font-weight: 700; font-size: clamp(2rem, 4vw, 3.1rem); line-height: 1.04; letter-spacing: -.03em; color: var(--sl-color-white); }
  .ob-body { margin: 1.1rem 0 0; max-width: 40ch; font-size: 1.1rem; line-height: 1.65; color: var(--sl-color-gray-2); }
  .ob-cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
  .ob-btn { display: inline-flex; align-items: center; padding: .9rem 1.3rem; border-radius: 12px; font-weight: 600; text-decoration: none; background: var(--kinuvo-accent); color: var(--agent-on, #fff); transition: transform .2s; }
  .ob-btn:hover { transform: translateY(-2px); }
