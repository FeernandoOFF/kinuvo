  .f4 { left: -230px; top: 18%; animation-delay: -.5s; }
  .f5 { right: -235px; top: 2%; animation-delay: -2s; }
  .f6 { right: -200px; top: 30%; animation-delay: -3s; }
  .f7 { left: -215px; top: 46%; animation-delay: -4s; }
  @keyframes ob-bob { 50% { transform: translateY(-12px); } }
  @keyframes ob-breathe { 50% { transform: scale(1.1); opacity: .75; } }

  /* ---------- the device, which changes shape ---------- */
  .ob-device {
    --w: 340px; --h: 620px;
    position: relative; width: var(--w); height: var(--h); border-radius: 44px; overflow: hidden;
    display: flex; flex-direction: column;
    background: #faf9f5; color: #1f1e1b; border: 9px solid #1b1a18;
    box-shadow: 0 50px 90px -40px rgba(40, 25, 15, .55);
    font-family: Inter, system-ui, sans-serif;
    transition: width .7s cubic-bezier(.65, 0, .25, 1), height .7s cubic-bezier(.65, 0, .25, 1), border-radius .7s ease, border-width .5s ease, border-color .5s ease, background .5s ease, color .5s ease;
  }
  .ob-device::before { content: ''; position: absolute; inset: 0 0 auto; height: 45%; pointer-events: none; transition: opacity .5s; background: radial-gradient(90% 70% at 50% 0%, color-mix(in srgb, var(--kinuvo-accent) 22%, transparent), transparent); }
  .ob-device[data-shape='wide'] { --w: 600px; --h: calc(var(--w) * 1800 / 2800 + 30px + 2.7rem); border-radius: 14px; border-width: 1px; border-color: #d9d5ca; }
  .ob-device[data-shape='term'] { --w: 540px; --h: 470px; border-radius: 14px; border-width: 1px; border-color: #3f3e3b; background: #1e1d1b; color: #edede6; }
  .ob-device[data-shape='term']::before { opacity: 0; }

  .ob-chrome { display: none; align-items: center; gap: 6px; height: 30px; flex-shrink: 0; padding: 0 12px; background: #f3f1ea; border-bottom: 1px solid #e3e0d6; font-size: .72rem; color: #75716a; }
  .ob-chrome i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; }
  .ob-chrome i:nth-child(2) { background: #febc2e; }
  .ob-chrome i:nth-child(3) { background: #28c840; }
  .ob-chrome span { margin: 0 auto; padding-right: 40px; }
  .ob-device:not([data-shape='phone']) .ob-chrome { display: flex; }
  .ob-device[data-shape='term'] .ob-chrome { background: #2a2927; border-color: #3f3e3b; color: #9c9a92; }

  .ob-bar { position: relative; display: flex; align-items: center; gap: .6rem; padding: 2rem 1.1rem .3rem; }
  .ob-device:not([data-shape='phone']) .ob-bar { display: none; }
  .ob-mini { width: 34px; flex-shrink: 0; }
  .ob-dots { display: flex; align-items: center; flex: 1; margin: 0; padding: 0; list-style: none; }
  .ob-dots li { flex: 1; height: 4px; margin: 0 2px; border-radius: 99px; background: #e3e0d6; overflow: hidden; position: relative; }
  .ob-dots li::after { content: ''; position: absolute; inset: 0; background: var(--kinuvo-accent); transform: scaleX(0); transform-origin: left; transition: transform .5s ease; }
