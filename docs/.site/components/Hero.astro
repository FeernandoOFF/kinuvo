---
// The landing page is the onboarding: a pinned device walks through setting up an Agent while the story scrolls past.
// Every screen is a small, interactive recreation of the app (shared/ui onboarding look); each also plays on its own.
import { Image } from 'astro:assets';
import { siAndroid, siApple, siLinux } from 'simple-icons';
import { looks, still } from './agents';
import Icon from './Icon.astro';
import desktop from '../assets/screens/shell-wide.png';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const steps = [
  { id: 'agent', eyebrow: 'Your Agent', title: 'First, who is it?', body: 'Pick how your Agent looks and give it a name. It’ll walk you through the rest, and the whole site takes its colour.' },
  { id: 'home', eyebrow: 'Where it runs', title: 'Your Agent lives where you choose', body: 'Keep the Server on this device, or put it on a laptop, a home server or a Docker box that all your Devices share. Either way, your data stays on machines you own.' },
  { id: 'mind', eyebrow: 'Model', title: 'Any mind, even the one in your pocket', body: 'Pick a cloud model like OpenAI’s, or Apple’s on-device model where it’s available. The provider decides where your messages are processed, and each conversation can use its own.' },
  { id: 'tools', eyebrow: 'Tools and Approvals', title: 'Useful, never reckless', body: 'Give your Agent your notes, your reminders, a shell or any MCP server. Every call has a Risk: reads just happen, and anything that changes things waits for your OK.' },
  { id: 'learn', eyebrow: 'Learning and Knowledge', title: 'It gets better, with your sign-off', body: 'After a conversation your Agent reflects. It curates its Memory, and proposes updates to your Obsidian or Anytype notes, and new Skills, for you to approve.' },
  { id: 'remind', eyebrow: 'Reminders and Tasks', title: '“Remind me…” Done.', body: 'Reminders and Tasks land in Apple Reminders or Kinuvo’s own list. Assign one to your Agent and follow it on the Board, and let Routines run on a schedule.' },
  { id: 'voice', eyebrow: 'Voice', title: 'Or just talk', body: 'Hold to talk, or start a voice chat. Speech recognition and the spoken reply run on your Device, and the conversation stays in the Session.' },
  { id: 'computer', eyebrow: 'Computer use', title: 'Hands on, when you allow it', body: 'Pair a Mac or an Android phone as a Computer. Your Agent sees the screen through accessibility and acts one app at a time, with Approvals, while you watch live.' },
  { id: 'everywhere', eyebrow: 'Every device', title: 'Not just your phone', body: 'The same Agent on macOS, Windows, Linux, Android, iPhone and in the browser. Pair a Device with a QR code and pick up wherever you left off.' },
  { id: 'install', eyebrow: 'Install', title: 'Ready when you are', body: 'One command installs the Server. Sign in to a model provider, pair your apps, and your Agent is waiting.' },
];
const tools = [
  { icon: 'note', name: 'Notes', sub: 'Obsidian or Anytype', risk: 'Low', on: true },
  { icon: 'alarm', name: 'Reminders', sub: 'Apple Reminders', risk: 'Medium', on: true },
  { icon: 'terminal', name: 'Shell', sub: 'Your Workspace', risk: 'High', on: true },
];
const ideas = ['call Ana tomorrow at 10', 'water the plants at 7', 'pay rent on the 1st'];
// Simple Icons has no Windows mark, so it and the browser globe are drawn here.
const windows = 'M0 0h11.4v11.4H0zM12.6 0H24v11.4H12.6zM0 12.6h11.4V24H0zM12.6 12.6H24V24H12.6z';
const globe = 'M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24zm7.9 7.2h-3.4a18.6 18.6 0 0 0-1.7-4.9 9.7 9.7 0 0 1 5.1 4.9zM12 2.4c1 1.3 1.8 2.9 2.3 4.8H9.7c.5-1.9 1.3-3.5 2.3-4.8zM2.7 14.4a9.8 9.8 0 0 1 0-4.8h3.9a20 20 0 0 0 0 4.8H2.7zm1.4 2.4h3.4c.4 1.8 1 3.4 1.7 4.9a9.7 9.7 0 0 1-5.1-4.9zm3.4-9.6H4.1a9.7 9.7 0 0 1 5.1-4.9 18.6 18.6 0 0 0-1.7 4.9zM12 21.6c-1-1.3-1.8-2.9-2.3-4.8h4.6c-.5 1.9-1.3 3.5-2.3 4.8zm2.8-7.2H9.2a17.6 17.6 0 0 1 0-4.8h5.6a17.6 17.6 0 0 1 0 4.8zm.4 7.3c.7-1.5 1.3-3.1 1.7-4.9h3.4a9.7 9.7 0 0 1-5.1 4.9zm2.2-7.3a20 20 0 0 0 0-4.8h3.9a9.8 9.8 0 0 1 0 4.8h-3.9z';
const platforms = [
  { name: 'iPhone', path: siApple.path }, { name: 'Android', path: siAndroid.path }, { name: 'macOS', path: siApple.path },
  { name: 'Windows', path: windows }, { name: 'Linux', path: siLinux.path }, { name: 'Browser', path: globe },
];
---

<section class="ob" data-guide-hero>
  <div class="ob-track">
  <div class="ob-stage">
    <div class="ob-caption"></div>
    <div class="ob-rig">
    <div class="ob-halo" aria-hidden="true"></div>
    <div class="ob-floats" aria-hidden="true">
      <span class="ob-float f1"><img src={still('Lilac Cloud')} alt="" /></span>
      <span class="ob-float f2"><img src={still('Mint Pill')} alt="" /></span>
      <span class="ob-float f3"><img src={still('Honey Star')} alt="" /></span>
      <span class="ob-float ob-pill f4"><b><Icon name="alert" /></b> Allow <code>git push</code>?</span>
      <span class="ob-pill ob-float f5"><b><Icon name="sparkles" /></b> Saved to Knowledge</span>
      <span class="ob-pill ob-float f6"><b><Icon name="lock" /></b> On-device model</span>
      <span class="ob-pill ob-float f7"><b><Icon name="alarm" /></b> Call Ana · 10:00</span>
    </div>
    <div class="ob-device" data-step="0" data-shape="phone">
      <div class="ob-chrome" aria-hidden="true"><i></i><i></i><i></i><span>Kinuvo</span></div>
      <div class="ob-bar">
        <kinuvo-avatar class="ob-mini" artboard={looks[0].artboard}><img src={still(looks[0].artboard)} alt="" /></kinuvo-avatar>
        <ol class="ob-dots" aria-label="Setup progress">
          {steps.map((_, i) => <li data-dot={i}></li>)}
        </ol>
      </div>

      <div class="ob-pages">
        <!-- 1 · Pick an Agent -->
        <div class="ob-page" data-page="0">
          <div class="p-pick">
            <kinuvo-avatar class="p-pick-me" artboard={looks[0].artboard} pokeable><img src={still(looks[0].artboard)} alt="" /></kinuvo-avatar>
            <h3>Hey, I’m <span data-agent-name>Milo</span></h3>
            <p class="p-sub">Tap to change how I look, then give me a name.</p>
            <div class="p-looks" role="radiogroup" aria-label="Agent look">
              {looks.map((look, i) => (
                <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-artboard={look.artboard} style={`--c:${look.color}`} title={look.artboard}>
                  <img src={still(look.artboard)} alt={look.artboard} />
                </button>
              ))}
            </div>
            <input class="p-name" type="text" maxlength="20" autocomplete="off" spellcheck="false" placeholder="Milo" aria-label="Your Agent’s name" />
          </div>
        </div>

        <!-- 2 · Where it runs -->
        <div class="ob-page" data-page="1">
          <h3>Where should I live?</h3>
          <p class="p-sub">You can add more later.</p>
          <div class="p-homes">
            <button type="button" class="p-card" data-home="device" aria-pressed="false"><b><Icon name="smartphone" /></b><strong>This device</strong></button>
            <button type="button" class="p-card" data-home="server" aria-pressed="true"><b><Icon name="server" /></b><strong>Your Server</strong></button>
          </div>
          <div class="p-net" data-home="server">
            <div class="p-node-me"><Icon name="smartphone" /></div>
            <div class="p-link"><div class="p-wire"><i></i><i></i><i></i></div></div>
            <div class="p-hosts"><span><Icon name="laptop" /> Laptop</span><span><Icon name="home" /> Home server</span><span><Icon name="container" /> Docker</span></div>
            <div class="p-local"><Icon name="lock" /> Nothing leaves this phone</div>
          </div>
        </div>

        <!-- 3 · Model -->
        <div class="ob-page" data-page="2">
          <h3>Which mind should I use?</h3>
          <p class="p-sub">Your model powers every conversation.</p>
          <div class="p-providers">
            <button type="button" class="p-provider" data-provider="apple" aria-pressed="true"><b><Icon name="apple" /></b><span><strong>Apple</strong><em>On this device</em></span><i class="p-tag">Private</i></button>
            <button type="button" class="p-provider" data-provider="codex" aria-pressed="false"><b><Icon name="cloud" /></b><span><strong>OpenAI Codex</strong><em>In the cloud</em></span><i class="p-tag">Signed in</i></button>
          </div>
          <div class="p-models">
            <p>Model</p>
            <ul data-for="apple"><li class="on">Apple on-device model</li><li>Apple Private Cloud Compute</li></ul>
            <ul data-for="codex" hidden><li class="on">GPT-5.6</li><li>GPT-5.6-mini</li></ul>
          </div>
          <p class="p-think"><span></span><span></span><span></span> Warming up…</p>
        </div>

        <!-- 4 · Tools and Approvals -->
        <div class="ob-page" data-page="3">
          <h3>What can I work with?</h3>
          <ul class="p-tools">
            {tools.map((t) => (
              <li>
                <b><Icon name={t.icon} /></b><span><strong>{t.name}</strong></span>
                <i class={`p-risk p-risk-${t.risk.toLowerCase()}`}>{t.risk}</i>
                <button type="button" class="p-switch" role="switch" aria-checked={t.on ? 'true' : 'false'} aria-label={`Use ${t.name}`}></button>
              </li>
            ))}
          </ul>
          <div class="p-chat">
            <p class="p-msg p-you">Push my fix to GitHub</p>
            <div class="p-approve">
              <p><b><Icon name="alert" /></b> Allow <code>shell</code>? <i class="p-risk p-risk-high">High</i></p>
              <code class="p-cmd">git push origin main</code>
              <div class="p-actions"><button type="button" data-answer="once">Allow once</button><button type="button" data-answer="always">Always allow</button><button type="button" data-answer="deny">Deny</button></div>
            </div>
            <p class="p-msg p-agent p-result"></p>
          </div>
        </div>

        <!-- 5 · Learning and Knowledge -->
        <div class="ob-page" data-page="4">
          <div class="p-chat">
            <p class="p-msg p-you">I moved to Dublin last month!</p>
            <p class="p-msg p-agent p-congrats">Congrats! How are you settling in?</p>
          </div>
          <div class="p-reflect">
            <p class="p-reflect-head"><Icon name="sparkles" /> Reflection needs your review</p>
            <p class="p-reflect-what">User Notes update</p>
            <pre class="p-diff"><del>− Lives in Cork</del><ins>+ Lives in Dublin</ins></pre>
            <div class="p-actions"><button type="button" data-review="approve">Approve</button><button type="button" data-review="reject">Reject</button></div>
          </div>
          <div class="p-note">
            <p class="p-note-head"><Icon name="obsidian" /> People / You · <em>Obsidian</em></p>
            <ul><li>Runs on Sundays</li><li class="p-note-home">Lives in Cork</li></ul>
          </div>
        </div>

        <!-- 6 · Reminders and Tasks -->
        <div class="ob-page" data-page="5">
          <h3>Remind me to…</h3>
          <div class="p-ideas">{ideas.map((idea) => <button type="button" data-idea={idea}>{idea}</button>)}</div>
          <ul class="p-reminders"><li><b>○</b><span><strong>Book flights to Lisbon</strong><em>Assigned to <span data-agent-name>Milo</span> · In progress</em></span></li></ul>
          <div class="p-board">
            <div><p>To do</p></div><div><p>In progress</p></div><div><p>Waiting on you</p></div>
            <span class="p-ticket"><Icon name="plane" /> Lisbon flights</span>
          </div>
        </div>

        <!-- 7 · Voice -->
        <div class="ob-page" data-page="6">
          <div class="p-voice" data-phase="">
            <p class="p-voice-state">Hold to talk</p>
            <p class="p-voice-you"></p>
            <p class="p-voice-me"></p>
            <div class="p-wave" aria-hidden="true">{Array.from({ length: 14 }, () => <i></i>)}</div>
            <button type="button" class="p-mic" aria-label="Hold to talk"><Icon name="mic" /></button>
          </div>
        </div>

        <!-- 8 · Computer use -->
        <div class="ob-page" data-page="7">
          <p class="p-watch"><span class="p-live"></span> Watching <strong>Mac mini</strong></p>
          <div class="p-mac">
            <div class="p-menubar"><Icon name="apple" /><b>Calendar</b><span>File</span><span>Edit</span><span>View</span><em><Icon name="wifi" /><Icon name="battery" />9:41</em></div>
            <div class="p-win">
              <div class="p-win-bar"><i></i><i></i><i></i><span>Calendar</span><button type="button" tabindex="-1" class="p-mac-btn"><Icon name="plus" /> New event</button></div>
              <div class="p-win-body">
                <aside class="p-cal-side"><p>Calendars</p><span><i style="--d:#5b8def"></i>Work</span><span><i style="--d:var(--kinuvo-accent)"></i>Home</span><span><i style="--d:#e5a03c"></i>Family</span></aside>
                <div class="p-cal-day">
                  <p class="p-cal-date">Monday 26</p>
                  <div class="p-hour"><em>9</em><span class="p-ev">Stand-up</span></div>
                  <div class="p-hour"><em>10</em><span class="p-ev p-ev-new">Call Ana</span></div>
                  <div class="p-hour"><em>11</em></div>
                  <div class="p-hour"><em>12</em><span class="p-ev p-ev-lunch">Lunch</span></div>
                </div>
              </div>
            </div>
            <div class="p-dock">
              <span style="--t:#5b8def"><Icon name="folder" /></span><span style="--t:#ffffff;color:#e5484d" class="p-dock-cal"><Icon name="calendar" /></span><span style="--t:#e5a03c"><Icon name="note" /></span><span style="--t:#2f9e6a"><Icon name="message" /></span><span style="--t:#3b82f6"><Icon name="compass" /></span><span class="p-dock-me"><img class="p-me-still" src={still(looks[0].artboard)} alt="" /></span>
            </div>
            <span class="p-cursor" aria-hidden="true"></span>
          </div>
          <div class="p-approve p-approve-app">
            <p><b><Icon name="alert" /></b> Allow in <strong>Calendar</strong>?</p>
            <div class="p-actions"><button type="button" data-app="once">Allow once</button><button type="button" data-app="always">Always allow in Calendar</button></div>
          </div>
        </div>

        <!-- 9 · Everywhere -->
        <div class="ob-page" data-page="8">
          <Image class="p-shot" src={desktop} alt="Kinuvo on the desktop: Agents, chats and an Approval in one window" widths={[700, 1400]} sizes="580px" />
          <div class="p-platforms">{platforms.map((p) => <span title={p.name}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={p.path} /></svg>{p.name}</span>)}</div>
        </div>

        <!-- 10 · Install -->
        <div class="ob-page" data-page="9">
          <pre class="p-term"><code></code></pre>
          <div class="p-pair"><img src={`${base}qr.png`} alt="Pairing QR code" /><p><strong>Scan with the Kinuvo app</strong><span>Works once, for ten minutes</span><em><Icon name="check" /> iPhone connected</em></p></div>
        </div>
      </div>

      <button type="button" class="ob-next">Continue</button>
    </div>
    </div>
  </div>
  </div>
  <header class="ob-intro">
    <h1 id="_top">Your Agents. <span>Your Server.</span></h1>
    <p class="ob-lede">A personal AI assistant you host yourself. Scroll, and your Agent will set itself up with you.</p>
    <p class="ob-scroll" aria-hidden="true"><span></span>Scroll to begin</p>
  </header>
  <div class="ob-steps">
    {steps.map((s, i) => (
      <article class="ob-step" data-step={i}>
        <p class="ob-eyebrow"><span class="ob-num">{String(i + 1).padStart(2, '0')}</span>{s.eyebrow}</p>
        <h2>{s.title}</h2>
        <p class="ob-body">{s.body}</p>
        {s.id === 'install' && (
          <div class="ob-cta">
            <a class="ob-btn" href={`${base}start/install/`}>Getting started →</a>
            <a class="ob-btn ob-btn-ghost" href={`${base}#install`}>Server and apps ↓</a>
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<script>
  import { AvatarState, type KinuvoAvatar } from './avatar';
  import { choose, current, looks, still, type Agent } from './agents';

  const root = document.querySelector<HTMLElement>('.ob')!;
  const device = root.querySelector<HTMLElement>('.ob-device')!;
  const stepEls = [...root.querySelectorAll<HTMLElement>('.ob-step')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string, el: ParentNode = device) => el.querySelector<T>(sel)!;
  const $$ = <T extends HTMLElement = HTMLElement>(sel: string, el: ParentNode = device) => [...el.querySelectorAll<T>(sel)];

  // One timeline at a time: changing step cancels whatever the previous screen was playing.
  let timers: number[] = [];
  const later = (fn: () => void, ms: number) => { timers.push(window.setTimeout(fn, reduced ? 0 : ms)); };
  const hush = () => { timers.forEach(clearTimeout); timers = []; };
  const typeInto = (el: HTMLElement, text: string, ms = 28, done?: () => void) => {
    el.textContent = '';
    if (reduced) { el.textContent = text; done?.(); return; }
    [...text].forEach((ch, i) => later(() => { el.textContent += ch; if (i === text.length - 1) done?.(); }, i * ms));
  };

  // ---- the Agent: every avatar in the device follows the pick ----
  let agent: Agent = current();
  const avatars = () => $$<KinuvoAvatar>('kinuvo-avatar');
  const mood = (state: number, poke = false) => avatars().forEach((a) => { a.state = state; if (poke) a.poke(); });
  const dress = () => {
    avatars().forEach((el) => {
      if (el.getAttribute('artboard') === agent.look.artboard) return;
      const next = document.createElement('kinuvo-avatar') as KinuvoAvatar;
      for (const a of el.attributes) next.setAttribute(a.name, a.value);
      next.setAttribute('artboard', agent.look.artboard);
      next.innerHTML = `<img src="${still(agent.look.artboard)}" alt="">`;
      el.replaceWith(next);
    });
    $$<HTMLButtonElement>('.p-looks button').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.artboard === agent.look.artboard)));
    document.querySelectorAll('[data-agent-name]').forEach((el) => (el.textContent = agent.name));
    $$<HTMLImageElement>('.p-me-still').forEach((img) => (img.src = still(agent.look.artboard)));
    name.placeholder = agent.look.name;
  };
  const name = $<HTMLInputElement>('.p-name');
  dress();
  if (agent.name !== agent.look.name) name.value = agent.name;

  $$<HTMLButtonElement>('.p-looks button').forEach((b) => b.addEventListener('click', () => {
    const look = looks.find((l) => l.artboard === b.dataset.artboard)!;
    agent = { look, name: name.value.trim() || look.name };
    choose(agent);
    dress();
    later(() => mood(AvatarState.Listening, true), 350);
    later(() => mood(AvatarState.Idle), 1600);
  }));
  name.addEventListener('focus', () => mood(AvatarState.Listening));
  name.addEventListener('blur', () => mood(AvatarState.Idle));
  name.addEventListener('input', () => { agent = { look: agent.look, name: name.value.trim() || agent.look.name }; choose(agent); dress(); });

  // ---- 2 · where it runs ----
  $$<HTMLButtonElement>('.p-homes [data-home]').forEach((b) => b.addEventListener('click', () => {
    $$('.p-homes [data-home]').forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
    $('.p-net').dataset.home = b.dataset.home!;
    mood(AvatarState.Listening, true);
    later(() => mood(AvatarState.Idle), 1200);
  }));


  // ---- 3 · model ----
  $$<HTMLButtonElement>('.p-provider').forEach((b) => b.addEventListener('click', () => {
    $$('.p-provider').forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
    $$('.p-models ul').forEach((u) => (u.hidden = u.dataset.for !== b.dataset.provider));
    const page = $('[data-page="2"]');
    page.dataset.phase = 'think';
    mood(AvatarState.Working);
    later(() => { page.dataset.phase = ''; mood(AvatarState.Idle, true); }, 1400);
  }));
  $$('.p-models li').forEach((li) => li.addEventListener('click', () => li.parentElement!.querySelectorAll('li').forEach((x) => x.classList.toggle('on', x === li))));

  // ---- 4 · tools and approvals ----
  $$<HTMLButtonElement>('.p-switch').forEach((s) => s.addEventListener('click', () => s.setAttribute('aria-checked', String(s.getAttribute('aria-checked') !== 'true'))));
  const answer = (how: string) => {
    const page = $('[data-page="3"]');
    if (page.dataset.phase !== 'ask') return;
    hush();
    page.dataset.phase = 'done';
    $('.p-result', page).textContent = how === 'deny' ? 'Okay, I won’t push. The fix stays local.' : how === 'always' ? 'Pushed ✓ Next time I won’t ask.' : 'Pushed to main ✓';
    mood(how === 'deny' ? AvatarState.Idle : AvatarState.Working);
    later(() => mood(AvatarState.Idle, true), 1200);
  };
  $$<HTMLButtonElement>('[data-answer]').forEach((b) => b.addEventListener('click', () => answer(b.dataset.answer!)));

  // ---- 5 · learning ----
  const review = (how: string) => {
    const page = $('[data-page="4"]');
    if (page.dataset.phase !== 'review') return;
    hush();
    page.dataset.phase = how;
    $('.p-note-home', page).textContent = how === 'approve' ? 'Lives in Dublin' : 'Lives in Cork';
    mood(AvatarState.Idle, true);
  };
  $$<HTMLButtonElement>('[data-review]').forEach((b) => b.addEventListener('click', () => review(b.dataset.review!)));

  // ---- 6 · reminders ----
  const remind = (what: string) => {
    const list = $('.p-reminders');
    const title = what.replace(/^./, (c) => c.toUpperCase());
    if ([...list.querySelectorAll('strong')].some((s) => s.textContent === title)) return;
    mood(AvatarState.Working);
    const li = list.querySelector('li:last-child')!.cloneNode(true) as HTMLElement;
    li.classList.add('p-new');
    li.querySelector('strong')!.textContent = title;
    li.querySelector('em')!.textContent = `Reminders · added by ${agent.name}`;
    later(() => { list.prepend(li); mood(AvatarState.Idle, true); }, 700);
  };
  $$<HTMLButtonElement>('[data-idea]').forEach((b) => b.addEventListener('click', () => remind(b.dataset.idea!)));

  // ---- 7 · voice ----
  const voice = $('.p-voice');
  const voiceState = $('.p-voice-state');
  const talk = (heard: string) => {
    hush();
    voice.dataset.phase = 'listen';
    mood(AvatarState.Listening);
    voiceState.textContent = 'Listening…';
    $('.p-voice-me').textContent = '';
    typeInto($('.p-voice-you'), heard, 45);
    later(() => {
      voice.dataset.phase = 'speak';
      mood(AvatarState.Working);
      voiceState.textContent = 'Speaking';
      typeInto($('.p-voice-me'), 'Two things: call Ana at 10, and your long run at 6.', 30, () => later(() => {
        voice.dataset.phase = '';
        voiceState.textContent = 'Hold to talk';
        mood(AvatarState.Idle);
      }, 900));
    }, 1900);
  };
  let held = false;
  $('.p-mic').addEventListener('pointerdown', (e) => {
    e.preventDefault();
    held = true;
    hush();
    voice.dataset.phase = 'listen';
    mood(AvatarState.Listening);
    voiceState.textContent = 'Listening… let go to send';
    $('.p-voice-you').textContent = '';
    $('.p-voice-me').textContent = '';
  });
  addEventListener('pointerup', () => { if (held) { held = false; talk('Anything I should know today?'); } });

  // ---- 8 · computer use ----
  const allowApp = () => {
    const page = $('[data-page="7"]');
    if (page.dataset.phase !== 'ask') return;
    hush();
    page.dataset.phase = 'click';
    mood(AvatarState.Working);
    later(() => { page.dataset.phase = 'done'; mood(AvatarState.Idle, true); }, 700);
  };
  $$<HTMLButtonElement>('[data-app]').forEach((b) => b.addEventListener('click', allowApp));

  // ---- what each screen plays when it arrives ----
  const enter: Record<number, () => void> = {
    0: () => mood(AvatarState.Idle),
    1: () => mood(AvatarState.Idle),
    2: () => mood(AvatarState.Idle),
    3: () => {
      const page = $('[data-page="3"]');
      page.dataset.phase = '';
      mood(AvatarState.Working);
      later(() => { page.dataset.phase = 'ask'; mood(AvatarState.NeedsYou); }, 1300);
      later(() => answer('once'), 7000);
    },
    4: () => {
      const page = $('[data-page="4"]');
      page.dataset.phase = '';
      $('.p-note-home', page).textContent = 'Lives in Cork';
      later(() => { page.dataset.phase = 'think'; mood(AvatarState.Working); }, 900);
      later(() => { page.dataset.phase = 'review'; mood(AvatarState.NeedsYou); }, 2400);
      later(() => review('approve'), 8000);
    },
    5: () => { mood(AvatarState.Idle); later(() => remind('call Ana tomorrow at 10'), 1400); },
    6: () => later(() => talk('What’s on today?'), 1200),
    7: () => {
      const page = $('[data-page="7"]');
      page.dataset.phase = '';
      mood(AvatarState.Working);
      later(() => (page.dataset.phase = 'move'), 600);
      later(() => { page.dataset.phase = 'ask'; mood(AvatarState.NeedsYou); }, 1900);
      later(allowApp, 5600);
    },
    8: () => mood(AvatarState.Idle, true),
    9: () => {
      const page = $('[data-page="9"]');
      page.dataset.phase = '';
      const code = $('.p-term code', page);
      code.textContent = '';
      const lines: [boolean, string][] = [
        [true, '$ curl -fsSL …/kinuvo/main/install.sh | sh'],
        [false, '✓ Installed kinuvo'],
        [true, '$ kinuvo login'],
        [false, '✓ Signed in to ChatGPT / Codex'],
        [true, '$ kinuvo service install'],
        [false, '✓ Server running at 127.0.0.1:8787'],
        [true, '$ kinuvo pair --manage'],
      ];
      let t = 300;
      lines.forEach(([typed, text]) => {
        later(() => {
          const row = document.createElement('span');
          row.className = typed ? 'cmd' : 'out';
          code.append(row);
          if (typed) typeInto(row, text, 22); else row.textContent = text;
        }, t);
        t += typed ? 250 + text.length * 22 : 450;
      });
      later(() => (page.dataset.phase = 'qr'), t + 200);
      later(() => { page.dataset.phase = 'paired'; mood(AvatarState.Idle, true); }, t + 2400);
    },
  };

  // ---- following the scroll ----
  const shapes: Record<number, string> = { 8: 'wide', 9: 'term' };
  const next = $<HTMLButtonElement>('.ob-next');
  let active = -1;
  const caption = root.querySelector<HTMLElement>('.ob-caption')!;
  const show = (i: number) => {
    if (i === active || i < 0) return;
    active = i;
    hush();
    device.dataset.step = String(i);
    device.dataset.shape = shapes[i] ?? 'phone';
    $$('.ob-page').forEach((p) => {
      const n = Number(p.dataset.page);
      p.dataset.at = n === i ? 'now' : n < i ? 'past' : 'next';
      p.inert = n !== i;
    });
    $$('[data-dot]').forEach((d) => {
      const n = Number(d.dataset.dot);
      d.dataset.state = n < i ? 'done' : n === i ? 'now' : '';
    });
    stepEls.forEach((s, n) => s.classList.toggle('is-now', n === i));
    // Phones pin the active step's text above the device instead of scrolling it.
    caption.classList.remove('swap');
    caption.innerHTML = stepEls[i].innerHTML;
    void caption.offsetWidth;
    caption.classList.add('swap');
    next.textContent = i === stepEls.length - 1 ? 'Get started' : 'Continue';
    enter[i]?.();
  };
  const narrow = matchMedia('(max-width: 56rem)');
  show(0);

  // ---- the intro: the device peeks from below the title, then rises into place as you scroll ----
  const stage = root.querySelector<HTMLElement>('.ob-stage')!;
  const rig = root.querySelector<HTMLElement>('.ob-rig')!;
  const intro = root.querySelector<HTMLElement>('.ob-intro')!;
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  let queued = false;
  const place = () => {
    queued = false;
    const h = intro.offsetHeight;
    const p = Math.min(1, Math.max(0, -intro.getBoundingClientRect().top / (h * 0.7)));
    const e = ease(p);
    const vh = stage.clientHeight;
    const dh = device.offsetHeight;
    // Phones: the device docks at the bottom under the text, scaled to fit, and rises a little out of its peek.
    // The device is laid out at full size and scaled to fit; phones keep it under the pinned text.
    const fit = narrow.matches
      ? Math.min(1, (vh - Math.max(vh * 0.34, caption.offsetHeight + 16) - 12) / dh, (stage.clientWidth - 24) / device.offsetWidth)
      : Math.min(1, (vh - 112) / dh, (stage.clientWidth * 0.44) / device.offsetWidth);
    // Desktop: at rest the device's top sits ~72% down the viewport; at the end it is centred.
    const peek = narrow.matches ? dh * fit * 0.5 : vh * 0.72 + (dh * fit) / 2 - vh / 2;
    // Desktop centres below the 4rem header.
    const end = narrow.matches ? 0 : 28;
    // Glide to the middle of the right-hand column of the content, wherever the full-width stage is centred.
    const box = root.getBoundingClientRect();
    const st = stage.getBoundingClientRect();
    const x = e * ((narrow.matches ? box.left + box.width / 2 : box.left + box.width * 0.75) - (st.left + st.width / 2));
    rig.style.transform = `translate3d(${x}px, ${peek + (end - peek) * e}px, 0) scale(${fit})`;
    root.style.setProperty('--p', p.toFixed(3));
    root.style.setProperty('--fw', `${device.offsetWidth}px`);
    // The active step is the last one whose top has passed the reading line, so any jump lands on the right screen.
    const line = innerHeight * 0.5;
    let at = 0;
    if (p >= 0.98) stepEls.forEach((el, n) => { if (el.getBoundingClientRect().top <= line) at = n; });
    show(at);
  };
  const queue = () => { if (!queued) { queued = true; requestAnimationFrame(place); } };
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  new ResizeObserver(queue).observe(device);
  new ResizeObserver(queue).observe(caption);
  place();

  next.addEventListener('click', () => {
    if (active === stepEls.length - 1) { location.href = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}start/install/`; return; }
    const target = stepEls[active + 1];
    const offset = narrow.matches ? 72 : innerHeight * 0.3;
    window.scrollTo({ top: target.getBoundingClientRect().top + scrollY - offset, behavior: reduced ? 'auto' : 'smooth' });
  });
</script>

<style>
  /* ---------- layout: the story scrolls, the device stays ---------- */
  /* The stage is a full-height sticky layer; --p (0 → 1) is how far the intro has scrolled away. */
  .ob { --p: 0; position: relative; }
  .ob-intro {
    position: relative; z-index: 1; min-height: calc(100vh - 4rem);
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start; text-align: center;
    padding-top: clamp(2.5rem, 9vh, 6rem);
    opacity: calc(1 - var(--p) * 1.6); transform: translateY(calc(var(--p) * -60px));
  }
  .ob-tag { justify-content: center; padding: .35rem .85rem; border-radius: 999px; background: var(--sl-color-accent-low); }
