  .ob-body { margin: 1.1rem 0 0; max-width: 44ch; font-size: 1.1rem; line-height: 1.7; color: var(--sl-color-gray-2); }
  .ob-scroll { display: flex; align-items: center; gap: .7rem; margin-top: 2.5rem; font-size: .85rem; color: var(--sl-color-gray-3); }
  .ob-scroll span { width: 1.3rem; height: 2rem; border: 2px solid var(--sl-color-gray-4); border-radius: 999px; position: relative; }
  .ob-scroll span::after { content: ''; position: absolute; left: 50%; top: .35rem; width: 4px; height: 6px; margin-left: -2px; border-radius: 2px; background: var(--kinuvo-accent); animation: ob-wheel 1.6s ease-in-out infinite; }
  @keyframes ob-wheel { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(10px); } }
  .ob-cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
  .ob-btn { display: inline-flex; align-items: center; padding: .9rem 1.3rem; border-radius: 12px; font-weight: 600; text-decoration: none; background: var(--kinuvo-accent); color: var(--agent-on, #fff); }
  .ob-btn-ghost { background: transparent; color: var(--sl-color-white); border: 1.5px solid var(--sl-color-gray-4); }

  .ob-track { position: absolute; inset: 0 calc(50% - 50vw); z-index: 3; pointer-events: none; overflow: clip; }
  .ob-stage { position: sticky; top: 0; height: 100vh; pointer-events: none; perspective: 1400px; }
  .ob-rig { position: absolute; inset: 0; display: grid; place-items: center; will-change: transform; }
  .ob-rig > * { grid-area: 1 / 1; }
  .ob-device { pointer-events: auto; transform: rotateX(calc((1 - var(--p)) * 14deg)) scale(calc(1.06 - var(--p) * .06)); transform-origin: 50% 0; }
  .ob-halo { width: min(640px, 70vw); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--kinuvo-accent) 32%, transparent), transparent); animation: ob-breathe 6s ease-in-out infinite; }
  .ob-floats { position: relative; width: var(--fw, 340px); height: min(690px, 80vh); opacity: calc(1 - var(--p) * 2.2); }
  .ob-float { position: absolute; animation: ob-bob 5s ease-in-out infinite; }
  .ob-float img { width: 100%; display: block; filter: drop-shadow(0 10px 16px rgba(40, 25, 15, .25)); }
  .f1, .f2, .f3 { width: 64px; }
