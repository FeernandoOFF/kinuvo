  .ob-rig > * { grid-area: 1 / 1; }
  .ob-device { pointer-events: auto; transform: rotateX(calc((1 - var(--p)) * 14deg)) scale(calc(1.06 - var(--p) * .06)); transform-origin: 50% 0; }
  @keyframes ob-bob { 50% { transform: translateY(-12px); } }

  /* ---------- the device, which changes shape ---------- */
  .ob-device {
    --w: 340px; --h: clamp(590px, calc(100vh - 150px), 700px);
    position: relative; width: var(--w); height: var(--h); border-radius: 44px; overflow: hidden;
    display: flex; flex-direction: column;
