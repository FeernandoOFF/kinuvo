  .f2 { right: -140px; top: 14%; width: 54px; animation-delay: -2.5s; }
  .f3 { left: -90px; top: 34%; width: 46px; animation-delay: -3.5s; }
  .ob-pill {
    display: inline-flex; align-items: center; gap: .4rem; white-space: nowrap; padding: .55rem .9rem; border-radius: 999px;
    font-size: .85rem; font-weight: 600; color: #1f1e1b; background: #fff;
