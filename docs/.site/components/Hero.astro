  .p-looks { display: grid; grid-template-columns: repeat(8, 1fr); gap: .25rem; width: 100%; margin-bottom: .7rem; }
  .p-looks button { aspect-ratio: 1; padding: .2rem; border-radius: 10px; border: 2px solid transparent; background: #fff; cursor: pointer; transition: transform .2s cubic-bezier(.3, 1.6, .5, 1), border-color .2s; }
  .p-looks button:hover { transform: translateY(-2px) rotate(-6deg); }
  .p-looks button[aria-checked='true'] { border-color: var(--c); transform: scale(1.12); box-shadow: 0 4px 12px -4px var(--c); }
