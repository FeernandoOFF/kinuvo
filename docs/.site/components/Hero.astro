  .p-name:focus { outline: none; border-color: var(--kinuvo-accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--kinuvo-accent) 20%, transparent); }

  /* 2 · where it runs */
  .p-homes { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
  .p-card { display: flex; flex-direction: column; gap: .2rem; text-align: left; padding: .75rem; border-radius: 16px; border: 1.5px solid #e3e0d6; background: #fff; cursor: pointer; transition: border-color .25s, transform .25s, box-shadow .25s; }
  .p-card b { font-size: 1.4rem; color: var(--kinuvo-accent); line-height: 1; margin-bottom: .2rem; }
  .p-card strong { font-family: Libron, Georgia, serif; font-size: .95rem; }
  .p-card span { font-size: .7rem; color: #75716a; }
  .p-card[aria-pressed='true'] { border-color: var(--kinuvo-accent); box-shadow: 0 8px 20px -12px var(--kinuvo-accent); transform: translateY(-2px); }
  /* A flex row, so the parts never overlap whatever the font size. */
  .p-net { position: relative; display: flex; align-items: center; gap: .5rem; height: 9rem; margin-top: .5rem; padding: 0 .8rem; border-radius: 18px; background: #f3f1ea; overflow: hidden; }
  .p-node-me { flex: none; margin-left: 0; font-size: 2rem; line-height: 0; color: #1f1e1b; transition: margin .6s cubic-bezier(.65, 0, .25, 1), font-size .6s, translate .6s; }
  .p-link { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: .45rem; transition: opacity .4s; }
  .p-wire { position: relative; width: 100%; height: 2px; background: repeating-linear-gradient(90deg, #d9d5ca 0 6px, transparent 6px 12px); }
  .p-wire i { position: absolute; top: -3px; width: 8px; height: 8px; border-radius: 50%; background: var(--kinuvo-accent); animation: ob-flow 1.8s linear infinite; }
  .p-wire i:nth-child(2) { animation-delay: .6s; }
  .p-wire i:nth-child(3) { animation-delay: 1.2s; }
  @keyframes ob-flow { from { left: 0; opacity: 0; } 15%, 85% { opacity: 1; } to { left: 100%; opacity: 0; } }
