  .ob-device:not([data-shape='phone']) .ob-bar { display: none; }
  .ob-mini { width: 34px; flex-shrink: 0; }
  .ob-dots { display: flex; align-items: center; flex: 1; margin: 0; padding: 0; list-style: none; }
  .ob-dots li { flex: 1; height: 4px; margin: 0 2px; border-radius: 99px; background: #e3e0d6; overflow: hidden; position: relative; }
  .ob-dots li::after { content: ''; position: absolute; inset: 0; background: var(--kinuvo-accent); transform: scaleX(0); transform-origin: left; transition: transform .5s ease; }
  .ob-dots li[data-state='done']::after, .ob-dots li[data-state='now']::after { transform: scaleX(1); }

  .ob-pages { position: relative; flex: 1; min-height: 0; overflow: hidden; }
  .ob-device[data-shape='multi'] .ob-pages { overflow: visible; }
  .ob-page { position: absolute; inset: 0; padding: .9rem 1.3rem 1rem; overflow: hidden; display: flex; flex-direction: column; justify-content: safe center; transition: transform .6s cubic-bezier(.65, 0, .25, 1), opacity .45s ease; }
  .ob-page:not([data-at]):not([data-page='0']) { opacity: 0; visibility: hidden; }
  .ob-page[data-at='past'] { transform: translateX(-35%); opacity: 0; }
  .ob-page[data-at='next'] { transform: translateX(35%); opacity: 0; }
  .ob-page h3 { margin: .2rem 0 .3rem; font-family: Libron, Georgia, serif; font-size: 1.5rem; line-height: 1.1; letter-spacing: -.02em; color: inherit; }
  .p-sub { margin: 0 0 1rem; font-size: .85rem; color: #75716a; }

  .ob-device .ob-next { flex-shrink: 0; margin: 0 1.1rem 1.1rem; padding: .85rem; border: 0; border-radius: 999px; cursor: pointer; background: #1f1e1b; color: #faf9f5; font: 600 .95rem Libron, Georgia, serif; transition: transform .2s ease, background .3s; }
  .ob-device .ob-next:hover { transform: translateY(-2px); background: color-mix(in srgb, var(--kinuvo-accent) 35%, #1f1e1b); }
  .ob-device a.ob-next { display: block; text-align: center; text-decoration: none; }
  .ob-device .ob-next[hidden] { display: none; }

  /* ---------- shared pieces ---------- */
  .ob-device button { font: inherit; color: inherit; }
  .p-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; margin-top: .55rem; }
  .p-actions button { min-height: 2.4rem; padding: .4rem .65rem; border-radius: 9px; border: 1px solid #e3e0d6; background: #fff; font-size: .74rem; font-weight: 600; cursor: pointer; transition: transform .15s ease; }
  .ob-device .p-actions button:first-child { background: var(--kinuvo-accent); border-color: var(--kinuvo-accent); color: var(--agent-on, #fff); }
  .p-actions button:hover { transform: translateY(-1px); }
  .ob-device .p-actions button[data-answer='deny'], .ob-device .p-actions button[data-review='reject'] { color: #c0392b; border-color: transparent; background: transparent; }
  .p-risk { font-style: normal; font-size: .62rem; font-weight: 700; padding: .12rem .45rem; border-radius: 99px; }
  .p-risk-low { color: #2f855a; background: #e3f3ea; }
  .p-risk-medium { color: #b7791f; background: #f8efdc; }
  .p-risk-high { color: #c0392b; background: #f9e1de; }
  .p-chat { display: flex; flex-direction: column; gap: .4rem; }
  .p-msg { margin: 0; max-width: 85%; padding: .5rem .75rem; border-radius: 14px; font-size: .8rem; line-height: 1.4; }
  .p-you { align-self: flex-end; background: #ece9e1; border-bottom-right-radius: 4px; }
  .p-agent { align-self: flex-start; background: color-mix(in srgb, var(--kinuvo-accent) 16%, #fff); border-bottom-left-radius: 4px; }
  @keyframes ob-pop { from { opacity: 0; transform: translateY(10px) scale(.97); } }
  .p-approve { padding: .65rem .7rem; border-radius: 14px; background: #fff; border: 1.5px solid color-mix(in srgb, #c0392b 35%, #e3e0d6); box-shadow: 0 10px 24px -14px rgba(192, 57, 43, .5); }
  .p-approve p { margin: 0; display: flex; align-items: center; gap: .35rem; font-size: .8rem; font-weight: 600; }
  .p-approve b { color: #c0392b; }
  .p-cmd { display: block; margin-top: .45rem; padding: .4rem .55rem; border-radius: 8px; background: #f3f1ea; font-size: .72rem; }

  /* 1 · pick an Agent */
  .p-pick { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .p-pick-me { width: 36%; margin: 0 auto .4rem; cursor: pointer; }
  .p-pick h3 { max-width: 100%; font-size: 1.8rem; margin-bottom: .55rem; overflow-wrap: anywhere; }
  .p-pick h3[data-long] { font-size: 1.4rem; }
  .p-pick h3[data-long] .p-hey { display: none; }
  .p-hint { display: inline-flex; align-items: center; gap: .4rem; margin: 0 0 .85rem; padding: .35rem .85rem; border-radius: 99px; font-size: .78rem; font-weight: 600; background: color-mix(in srgb, var(--kinuvo-accent) 14%, #fff); color: color-mix(in srgb, var(--kinuvo-accent) 70%, #1f1e1b); animation: ob-tap 1.8s ease-in-out infinite; }
  .p-hint :global(.icon) { font-size: 1rem; animation: ob-point 1.8s ease-in-out infinite; }
  .ob[data-picked] .p-hint, .ob[data-picked] .p-hint :global(.icon) { animation: none; }
  @keyframes ob-tap { 50% { transform: scale(1.05); } }
  @keyframes ob-point { 50% { transform: translateY(3px) rotate(-8deg); } }
  .p-looks { display: grid; grid-template-columns: repeat(4, 1fr); gap: .55rem; width: 100%; margin-bottom: .9rem; }
  .p-looks button { aspect-ratio: 1; min-height: 2.75rem; padding: .45rem; border-radius: 16px; border: 2px solid #ece9e1; background: #fff; cursor: pointer; transition: transform .25s cubic-bezier(.3, 1.6, .5, 1), border-color .2s, box-shadow .2s; }
  .ob:not([data-picked]) .p-looks button:not([aria-pressed='true']) { animation: ob-ping 2.2s ease-out calc(var(--i) * .15s) infinite; }
  @keyframes ob-ping { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c) 45%, transparent); } 60%, 100% { box-shadow: 0 0 0 9px transparent; } }
  .p-looks button:hover { transform: translateY(-3px) rotate(-6deg); border-color: var(--c); }
  .p-looks button[aria-pressed='true'] { border-color: var(--c); transform: scale(1.08); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 22%, transparent), 0 8px 16px -8px var(--c); }
  .p-looks img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .p-name { width: 100%; padding: .6rem .8rem; border-radius: 12px; border: 1.5px solid #e3e0d6; background: #fff; font: inherit; font-size: .9rem; color: #1f1e1b; text-align: center; }
  .p-name:focus { outline: none; border-color: var(--kinuvo-accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--kinuvo-accent) 20%, transparent); }

  /* 2 · where it runs */
  .p-homes { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
  .p-card { display: flex; flex-direction: column; gap: .2rem; text-align: left; padding: .75rem; border-radius: 16px; border: 1.5px solid #e3e0d6; background: #fff; cursor: pointer; transition: border-color .25s, transform .25s, box-shadow .25s; }
  .p-card b { font-size: 1.4rem; color: var(--kinuvo-accent); line-height: 1; margin-bottom: .2rem; }
  .p-card strong { font-family: Libron, Georgia, serif; font-size: .95rem; }
  .p-card span { font-size: .7rem; color: #75716a; }
  .p-card[aria-pressed='true'] { border-color: var(--kinuvo-accent); box-shadow: 0 8px 20px -12px var(--kinuvo-accent); transform: translateY(-2px); }
  /* A flex row, so the parts never overlap whatever the font size. */
  .p-net { position: relative; display: flex; align-items: center; gap: .5rem; height: 9rem; margin-top: .5rem; padding: 0 .8rem; border-radius: 18px; background: #f3f1ea; overflow: hidden; }
  .p-node-me { flex: none; margin-left: 0; font-size: 2rem; line-height: 0; color: #1f1e1b; transition: margin .6s cubic-bezier(.65, 0, .25, 1), font-size .6s, translate .6s; }
  .p-link { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: .45rem; transition: opacity .4s; }
  .p-wire { position: relative; width: 100%; height: 2px; background: repeating-linear-gradient(90deg, #d9d5ca 0 6px, transparent 6px 12px); }
  .p-wire i { position: absolute; top: -3px; width: 8px; height: 8px; border-radius: 50%; background: var(--kinuvo-accent); animation: ob-flow 1.8s linear infinite; }
  .p-wire i:nth-child(2) { animation-delay: .6s; }
  .p-wire i:nth-child(3) { animation-delay: 1.2s; }
  @keyframes ob-flow { from { left: 0; opacity: 0; } 15%, 85% { opacity: 1; } to { left: 100%; opacity: 0; } }
  .p-hosts { flex: none; display: grid; gap: .35rem; transition: opacity .4s; }
  .p-hosts span { display: inline-flex; align-items: center; gap: .35rem; font-size: .72rem; padding: .35rem .6rem; border-radius: 10px; background: #fff; border: 1px solid #e3e0d6; white-space: nowrap; }
  .p-local { display: inline-flex; align-items: center; gap: .35rem; position: absolute; left: 50%; bottom: 1rem; translate: -50% 0; white-space: nowrap; font-size: .75rem; padding: .35rem .7rem; border-radius: 99px; background: #e3f3ea; color: #2f855a; opacity: 0; transition: opacity .4s; }
  .p-net[data-home='device'] .p-node-me { margin-left: calc(50% - 1.7rem); font-size: 3.4rem; translate: 0 -.8rem; }
  .p-net[data-home='device'] .p-link, .p-net[data-home='device'] .p-hosts { opacity: 0; }
  .p-net[data-home='device'] .p-local { opacity: 1; }

  /* 3 · model */
  .p-providers { display: grid; gap: .45rem; }
  .p-provider { display: flex; align-items: center; gap: .7rem; padding: .7rem .8rem; border-radius: 14px; border: 1.5px solid #e3e0d6; background: #fff; text-align: left; cursor: pointer; transition: border-color .25s, box-shadow .25s; }
  .p-provider b { width: 2rem; height: 2rem; border-radius: 10px; display: grid; place-items: center; background: #1f1e1b; color: #fff; font-size: 1.05rem; }
  .p-provider span { display: flex; flex-direction: column; flex: 1; }
  .p-provider strong { font-size: .88rem; }
  .p-provider em { font-style: normal; font-size: .7rem; color: #75716a; }
  .p-tag { font-style: normal; font-size: .62rem; font-weight: 700; padding: .15rem .45rem; border-radius: 99px; background: #e3f3ea; color: #2f855a; }
  .p-provider:not([data-provider='apple']) .p-tag { background: #ece9e1; color: #75716a; }
  .p-provider[aria-pressed='true'] { border-color: var(--kinuvo-accent); box-shadow: 0 8px 20px -12px var(--kinuvo-accent); }
  .p-models { margin-top: .9rem; }
  .p-models ul { list-style: none; margin: 0; padding: .3rem; border-radius: 14px; background: #fff; border: 1px solid #e3e0d6; animation: ob-pop .4s ease; }
  .p-models li { margin: 0; padding: .55rem .6rem; border-radius: 10px; font-size: .82rem; cursor: pointer; display: flex; justify-content: space-between; }
  .p-models li.on { background: color-mix(in srgb, var(--kinuvo-accent) 14%, #fff); font-weight: 600; }
  .p-models li.on::after { content: '✓'; color: var(--kinuvo-accent); }
  @keyframes ob-dot { 50% { transform: translateY(-4px); opacity: .4; } }

  /* 4 · tools and approvals */
  .p-tools { list-style: none; margin: 0 0 .7rem; padding: 0; display: grid; gap: .3rem; }
  .p-tools li { margin: 0; display: flex; align-items: center; gap: .55rem; padding: .35rem .55rem; border-radius: 12px; background: #fff; border: 1px solid #ece9e1; }
  .p-tools b { width: 1.7rem; display: grid; place-items: center; font-size: 1.05rem; color: #514d46; }
  .p-tools span { display: flex; flex-direction: column; flex: 1; }
  .p-tools strong { font-size: .8rem; }
  .p-tools em { font-style: normal; font-size: .65rem; color: #75716a; }
  .p-switch { position: relative; width: 2.1rem; height: 1.2rem; flex-shrink: 0; border-radius: 99px; border: 0; background: #d9d5ca; position: relative; cursor: pointer; transition: background .25s; }
  .p-switch::before { content: ''; position: absolute; inset: -.85rem -.45rem; }
  .p-switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: calc(1.2rem - 4px); height: calc(1.2rem - 4px); border-radius: 50%; background: #fff; transition: transform .25s cubic-bezier(.3, 1.4, .5, 1); box-shadow: 0 1px 3px rgba(0, 0, 0, .2); }
  .p-switch[aria-checked='true'] { background: var(--kinuvo-accent); }
  .p-switch[aria-checked='true']::after { transform: translateX(.9rem); }
  [data-page='3'] .p-chat { min-height: 11rem; }
  [data-page='3'] .p-approve, [data-page='3'] .p-result { display: none; }
  [data-page='3'][data-phase='ask'] .p-approve, [data-page='3'][data-phase='done'] .p-result { display: block; animation: ob-pop .45s cubic-bezier(.2, .9, .3, 1.2); }

  /* 5 · learning */
  [data-page='4'] .p-congrats { opacity: 0; transition: opacity .4s; }
  [data-page='4']:is([data-phase='think'], [data-phase='review'], [data-phase='approve'], [data-phase='reject']) .p-congrats { opacity: 1; }
  .p-auto { display: flex; align-items: center; gap: .4rem; margin: .7rem 0 0; font-size: .76rem; color: #514d46; opacity: 0; transition: opacity .4s; }
  .p-auto :global(.icon) { color: #2f855a; }
  [data-page='4']:is([data-phase='think'], [data-phase='review'], [data-phase='approve'], [data-phase='reject']) .p-auto { opacity: 1; }
  .p-reflect { margin-top: .8rem; padding: .7rem .75rem; border-radius: 14px; background: #fff; border: 1px solid #e3e0d6; box-shadow: 0 12px 26px -16px rgba(40, 25, 15, .4); opacity: 0; transform: translateY(14px); transition: opacity .4s, transform .5s cubic-bezier(.2, .9, .3, 1.2); }
  [data-page='4']:is([data-phase='review'], [data-phase='approve'], [data-phase='reject']) .p-reflect { opacity: 1; transform: none; }
  .p-reflect p { margin: 0; }
  .p-reflect-head { display: flex; align-items: center; gap: .35rem; font-size: .8rem; font-weight: 700; color: color-mix(in srgb, var(--kinuvo-accent) 70%, #1f1e1b); }
  .ob-device .p-reflect-what { margin-top: .35rem; font-size: .74rem; font-weight: 600; }
  .p-diff { margin: .35rem 0 0; padding: .4rem .5rem; border-radius: 8px; background: #faf9f5; font-size: .72rem; line-height: 1.6; display: grid; }
  .p-diff del { color: #c0392b; background: #f9e1de; text-decoration: none; padding: 0 .3rem; border-radius: 4px; }
  .p-diff ins { color: #2f855a; background: #e3f3ea; text-decoration: none; padding: 0 .3rem; border-radius: 4px; }
  [data-page='4'][data-phase='approve'] .p-reflect .p-actions::after { content: '✓ Saved to Knowledge'; font-size: .74rem; font-weight: 700; color: #2f855a; }
  [data-page='4'][data-phase='reject'] .p-reflect .p-actions::after { content: 'Kept as it was'; font-size: .74rem; color: #75716a; }
  [data-page='4']:is([data-phase='approve'], [data-phase='reject']) .p-reflect .p-actions button { display: none; }
  .p-note { margin-top: .6rem; padding: .6rem .75rem; border-radius: 14px; background: #f3f1ea; }
  .p-note-head { display: flex; align-items: center; gap: .35rem; margin: 0 0 .3rem; font-size: .72rem; font-weight: 600; }
  .p-note-head em { font-weight: 400; color: #75716a; }
  .p-note ul { margin: 0; padding-left: 1rem; font-size: .74rem; line-height: 1.6; }
  .p-note li { margin: 0; }
  [data-page='4'][data-phase='approve'] .p-note-home { background: #e3f3ea; color: #2f855a; border-radius: 4px; padding: 0 .3rem; animation: ob-pop .5s ease; }

  /* 6 · reminders */
  .p-tasks { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .p-tasks li { margin: 0; display: flex; gap: .6rem; align-items: flex-start; padding: .6rem .7rem; border-radius: 12px; background: #fff; border: 1px solid #ece9e1; transition: border-color .3s, background .3s; }
  .p-tasks b { font-weight: 400; font-size: 1.1rem; line-height: 1; color: #9c9a92; width: 1.1rem; height: 1.1rem; display: grid; place-items: center; }
  .p-tasks li > span { display: flex; flex-direction: column; gap: .1rem; }
  .p-tasks strong { font-size: .84rem; }
  .p-tasks em { font-style: normal; font-size: .7rem; color: #75716a; }
  .p-mine { border-color: color-mix(in srgb, var(--kinuvo-accent) 40%, #ece9e1); }
  .p-mine[data-state='doing'] b { border: 2px solid color-mix(in srgb, var(--kinuvo-accent) 25%, #fff); border-top-color: var(--kinuvo-accent); border-radius: 50%; font-size: 0; animation: ob-spin .8s linear infinite; }
  .p-mine[data-state='done'] { background: color-mix(in srgb, var(--kinuvo-accent) 8%, #fff); }
  .p-mine[data-state='done'] b { background: var(--kinuvo-accent); color: var(--agent-on, #fff); border-radius: 50%; font-size: .7rem; }
  .p-mine[data-state='done'] b::after { content: '✓'; }
  .p-mine[data-state='done'] b { font-size: 0; }
  .p-mine[data-state='done'] b::after { font-size: .7rem; }
  .p-banner { display: flex; align-items: center; gap: .6rem; margin-bottom: .6rem; padding: .55rem .7rem; border-radius: 16px; background: #fff; box-shadow: 0 12px 26px -14px rgba(40, 25, 15, .45), 0 0 0 1px rgba(0, 0, 0, .05); opacity: 0; transform: translateY(-1.2rem); transition: opacity .35s, transform .5s cubic-bezier(.2, .9, .3, 1.2); }
  [data-page='5'][data-phase='done'] .p-banner { opacity: 1; transform: none; }
  .p-banner img { width: 2rem; height: 2rem; object-fit: contain; }
  .p-banner span { display: grid; flex: 1; min-width: 0; }
  .p-banner strong { font-size: .8rem; }
  .p-banner em { font-style: normal; font-size: .74rem; color: #514d46; }
  .p-banner i { font-style: normal; font-size: .66rem; color: #9c9a92; }

  /* 7 · voice */
  .p-voice { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: .6rem; padding-bottom: .4rem; text-align: center; }
  .p-voice-state { margin: 0 0 auto; padding: .3rem .8rem; border-radius: 99px; background: #ece9e1; font-size: .72rem; font-weight: 600; }
  .p-voice-you { margin: 0; font-family: Libron, Georgia, serif; font-size: 1.35rem; min-height: 1.7rem; }
  .p-voice-me { margin: 0; font-size: .85rem; line-height: 1.5; color: #514d46; min-height: 2.6rem; max-width: 16rem; }
  .p-wave { display: flex; align-items: center; gap: 4px; height: 3rem; }
  .p-wave i { width: 5px; height: 6px; border-radius: 3px; background: var(--kinuvo-accent); opacity: .35; }
  .p-voice:is([data-phase='listen'], [data-phase='speak']) .p-wave i { opacity: 1; animation: ob-wave .9s ease-in-out infinite; }
  .p-wave i:nth-child(odd) { animation-delay: -.3s; }
  .p-wave i:nth-child(3n) { animation-delay: -.6s; }
  @keyframes ob-wave { 0%, 100% { height: 6px; } 50% { height: 2.6rem; } }
  .ob-device .p-mic { display: grid; place-items: center; width: 4.5rem; color: var(--agent-on, #fff); height: 4.5rem; border-radius: 50%; border: 0; background: var(--kinuvo-accent); font-size: 1.9rem; cursor: pointer; touch-action: none; user-select: none; -webkit-user-select: none; transition: transform .2s; }
  .p-voice[data-phase='listen'] .p-mic { transform: scale(1.12); animation: ob-ring 1.2s ease-out infinite; }
  @keyframes ob-ring { from { box-shadow: 0 0 0 0 color-mix(in srgb, var(--kinuvo-accent) 55%, transparent); } to { box-shadow: 0 0 0 22px transparent; } }

  /* 8 · computer use */
  .p-watch { margin: .2rem 0 .6rem; display: flex; align-items: center; gap: .4rem; font-size: .8rem; }
  .p-live { width: 8px; height: 8px; border-radius: 50%; background: #e5484d; animation: ob-dot 1.2s ease-in-out infinite; }
  .p-mac { position: relative; height: 17rem; border-radius: 12px; overflow: hidden; background: radial-gradient(120% 90% at 20% 0%, #f6d3c2, transparent 60%), linear-gradient(135deg, color-mix(in srgb, var(--kinuvo-accent) 35%, #c7b8f0), #8fb3e8); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .08); }
  .p-menubar { display: flex; align-items: center; gap: .55rem; height: 18px; padding: 0 .55rem; background: rgba(255, 255, 255, .55); backdrop-filter: blur(8px); font-size: .56rem; color: #1f1e1b; }
  .p-menubar b { font-weight: 700; }
  .p-menubar em { margin-left: auto; display: inline-flex; align-items: center; gap: .35rem; font-style: normal; font-weight: 600; }
  .p-win { position: absolute; left: 6%; right: 6%; top: 28px; bottom: 46px; border-radius: 9px; overflow: hidden; background: #fff; box-shadow: 0 14px 30px -10px rgba(0, 0, 0, .45), 0 0 0 .5px rgba(0, 0, 0, .2); display: flex; flex-direction: column; }
  .p-win-bar { position: relative; display: flex; align-items: center; gap: 4px; height: 22px; padding: 0 .5rem; background: #f3f1ea; border-bottom: 1px solid #e3e0d6; flex-shrink: 0; }
  .p-win-bar i { width: 7px; height: 7px; border-radius: 50%; background: #ff5f57; }
  .p-win-bar i:nth-child(2) { background: #febc2e; }
  .p-win-bar i:nth-child(3) { background: #28c840; }
  .p-win-bar span { position: absolute; left: 50%; translate: -50% 0; font-size: .56rem; font-weight: 600; color: #75716a; }
  .ob-device .p-mac-btn { margin-left: auto; display: inline-flex; align-items: center; gap: .15rem; padding: .12rem .4rem; border: 0; border-radius: 5px; background: #1f1e1b; color: #fff; font-size: .5rem; font-weight: 700; white-space: nowrap; pointer-events: none; transition: transform .15s, background .2s; }
