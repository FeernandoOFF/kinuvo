  .ob:not([data-picked]) .ob-picker button { animation: ob-nudge 2.8s ease-in-out calc(var(--i) * .1s + .8s) infinite; }
  .ob-picker button.hop, .p-looks button.hop { animation: ob-hop .6s cubic-bezier(.3, 1.6, .5, 1); }
