  .ob-lede { margin: 1.25rem auto 0; max-width: 40ch; font-size: clamp(1rem, 1.6vw, 1.2rem); line-height: 1.6; color: var(--sl-color-gray-2); }
  .ob-intro .ob-scroll { margin-top: 1.75rem; }
  .ob-steps { position: relative; z-index: 1; width: 50%; padding-bottom: 25vh; }
  .ob-caption { display: none; }
  @keyframes ob-cap { from { opacity: 0; transform: translateY(10px); } }
  .ob-step { min-height: 88vh; display: flex; flex-direction: column; justify-content: center; opacity: .25; transform: translateY(14px); transition: opacity .5s ease, transform .6s cubic-bezier(.2, .8, .2, 1); }
  .ob-step.is-now { opacity: 1; transform: none; }
  .ob-eyebrow { display: flex; align-items: center; gap: .6rem; margin: 0 0 1rem; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--sl-color-accent-high); }
  .ob-num { font-variant-numeric: tabular-nums; padding: .15rem .5rem; border-radius: 999px; background: var(--sl-color-accent-low); }
  .ob h1 { margin: 0; font-family: Libron, Georgia, serif; font-weight: 400; font-size: clamp(3rem, 6.4vw, 5.4rem); line-height: .98; letter-spacing: -.045em; color: var(--sl-color-white); }
