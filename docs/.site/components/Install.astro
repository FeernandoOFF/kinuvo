---
// Install: lead with the desktop app (it can run the Server), then pairing, then the standalone Server for those who want it. The picked Agent waits at the end.
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import { siAndroid, siApple, siLinux } from 'simple-icons';
import { looks, still } from './agents';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/FeernandoOFF/kinuvo';
const releases = `${repo}/releases/latest`;
const windows = 'M3 5.4 10.4 4.4v7.1H3zM11.4 4.2 21 2.9v8.6h-9.6zM3 12.5h7.4v7.1L3 18.6zM11.4 12.5H21v8.6l-9.6-1.3z';
const apps = [
  { name: 'Desktop', detail: 'Mac, Windows or Linux. Can run your Server for you.', link: releases, cta: 'Download', icon: 'laptop', logos: [siApple.path, siLinux.path, windows] },
  { name: 'Android', detail: 'Download the APK, or build it yourself.', link: releases, cta: 'Get the APK', soon: 'Google Play soon', icon: 'smartphone', logos: [siAndroid.path] },
  { name: 'iPhone', detail: 'Build it with Xcode for now. The App Store release is on its way.', link: `${repo}/blob/main/apps/ios/README.md`, cta: 'Build it yourself', soon: 'App Store soon', icon: 'smartphone', logos: [siApple.path] },
  { name: 'Browser', detail: 'Every Server includes a web app. Reach it with Tailscale or your own domain.', link: `${base}guides/browser-access/`, cta: 'Set up access', icon: 'compass', logos: [] },
];
---

<section class="k-install" id="install" data-guide="That's the tour! Grab the app, pair your phone, and I'll be waiting for you." data-guide-state="idle">
  <header class="k-head">
    <p class="k-eyebrow">Install</p>
    <h2>Up and running in minutes</h2>
    <p class="k-lede">Get the desktop app, scan a QR code with your phone, done.</p>
  </header>

  <ol class="k-steps">
    <li>
      <span class="k-num">1</span>
      <div class="k-body">
        <h3>Get the app</h3>
        <p>Start with the desktop app. It can run your Server for you, so there’s nothing else to install.</p>
        <div class="k-apps">
          {apps.map((app, i) => (
            <a class:list={['k-app', { 'k-first': i === 0 }]} href={app.link}>
              <span class="k-app-icon"><Icon name={app.icon} /></span>
              {i === 0 ? <span class="k-soon k-start">Start here</span> : app.soon && <span class="k-soon">{app.soon}</span>}
              <strong>{app.name}</strong>
              <span class="k-app-detail">{app.detail}</span>
              <span class="k-app-foot">
                <span class="k-cta">{app.cta} <span aria-hidden="true">→</span></span>
                <span class="k-logos" aria-hidden="true">{app.logos.map((d) => <svg viewBox="0 0 24 24"><path d={d} /></svg>)}</span>
              </span>
            </a>
          ))}
        </div>
        <p class="k-small"><Icon name="alert" /> The desktop apps aren't code-signed yet. <a href={`${base}start/install/`}>How to open them</a></p>
      </div>
    </li>

    <li>
      <span class="k-num">2</span>
      <div class="k-body">
        <h3>Pair your phone</h3>
        <p>Show the pairing QR code and scan it with the Kinuvo app. Each code works once, for ten minutes. Running the Server from a terminal? Ask it for a code:</p>
        <Code lang="sh" code="kinuvo pair --manage" />
      </div>
    </li>

  </ol>

  <aside class="k-optional">
    <span class="k-tag">Optional</span>
    <h3>Give the Server its own home</h3>
    <p>Run it on a home server, a Mac mini or in Docker, so every Device can reach it even when your laptop is closed. The installer bundles its own Java runtime.</p>
    <Tabs syncKey="os">
      <TabItem label="macOS / Linux">
        <Code lang="sh" code={`curl -fsSL https://raw.githubusercontent.com/FeernandoOFF/kinuvo/main/install.sh | sh\nkinuvo login\nkinuvo service install`} />
      </TabItem>
      <TabItem label="Windows">
        <Code lang="powershell" code={`irm https://raw.githubusercontent.com/FeernandoOFF/kinuvo/main/install.ps1 | iex\nkinuvo login\nkinuvo service install`} />
      </TabItem>
      <TabItem label="Docker">
        <Code lang="sh" code={`docker run -d --name kinuvo -p 127.0.0.1:8787:8787 -v kinuvo:/data ghcr.io/feernandooff/kinuvo\ndocker exec -it kinuvo kinuvo login`} />
      </TabItem>
    </Tabs>
  </aside>

  <div class="k-done">
    <span class="k-me"><kinuvo-avatar artboard={looks[0].artboard} pokeable><img src={still(looks[0].artboard)} alt="" /></kinuvo-avatar></span>
    <p><strong>That’s it.</strong> <span data-agent-name>Milo</span> is waiting for you.</p>
    <a class="k-go" href={`${base}start/install/`}>Open the Getting started guide →</a>
  </div>
</section>

<script>
  import './avatar';
  import { current, still, type Agent } from './agents';

  const slot = document.querySelector<HTMLElement>('.k-me')!;
  const dress = (agent: Agent) => {
    const old = slot.querySelector('kinuvo-avatar')!;
    if (old.getAttribute('artboard') === agent.look.artboard) return;
    const next = old.cloneNode(false) as HTMLElement;
    next.setAttribute('artboard', agent.look.artboard);
    next.innerHTML = `<img src="${still(agent.look.artboard)}" alt="">`;
    old.replaceWith(next);
  };
  dress(current());
  document.addEventListener('kinuvo:agent', (e) => dress((e as CustomEvent<Agent>).detail));
</script>

<style>
  .k-install { padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 4rem); scroll-margin-top: 5rem; max-width: 60rem; margin-inline: auto; }

  .k-head { text-align: center; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .k-eyebrow { display: inline-block; margin: 0 0 1rem; padding: .3rem .8rem; border-radius: 999px; background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .k-head h2 { margin: 0; font-size: clamp(2rem, 4.4vw, 3.2rem); line-height: 1.05; letter-spacing: -.03em; }
  .k-lede { margin: .9rem auto 0; max-width: 52ch; font-size: 1.1rem; color: var(--sl-color-gray-2); }

  /* A timeline: numbered nodes on a rail, content beside them. */
  .k-steps { list-style: none; padding: 0; margin: 0; }
  .k-steps > li { position: relative; display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: clamp(1rem, 3vw, 1.75rem); margin: 0; padding-bottom: clamp(2rem, 5vw, 3rem); }
  .k-steps > li::before { content: ''; position: absolute; left: calc(1.25rem - 1px); top: 2.9rem; bottom: .4rem; width: 2px; border-radius: 2px; background: linear-gradient(var(--kinuvo-accent), color-mix(in srgb, var(--kinuvo-accent) 10%, transparent)); opacity: .55; }
  .k-steps > li:last-child::before { display: none; }
  .k-num {
    width: 2.5rem; height: 2.5rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--kinuvo-accent); color: var(--agent-on, #fff); font-weight: 700;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--kinuvo-accent) 18%, transparent);
  }
  .k-body { min-width: 0; padding-top: .2rem; }
  .k-body h3 { margin: 0; font-size: 1.6rem; letter-spacing: -.02em; }
  .k-body > p { margin: .5rem 0 1.1rem; max-width: 60ch; color: var(--sl-color-gray-2); line-height: 1.6; }

  .k-apps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
  .k-app {
    position: relative; display: flex; flex-direction: column; gap: .3rem;
    padding: 1.15rem 1.2rem 1rem; border-radius: 18px;
    border: 1px solid var(--sl-color-hairline); background: var(--kinuvo-panel);
    text-decoration: none; color: inherit;
    transition: transform .25s cubic-bezier(.2, .8, .2, 1), border-color .2s, box-shadow .25s;
  }
  .k-app:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--kinuvo-accent) 60%, var(--sl-color-hairline)); box-shadow: 0 18px 36px -22px color-mix(in srgb, var(--kinuvo-accent) 60%, #000); }
  .k-app-icon { width: 2.4rem; height: 2.4rem; margin-bottom: .45rem; border-radius: 12px; display: grid; place-items: center; font-size: 1.2rem; background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); }
  .k-soon { position: absolute; top: 1.1rem; right: 1.1rem; padding: .2rem .55rem; border-radius: 999px; font-size: .68rem; font-weight: 600; color: var(--sl-color-gray-2); background: var(--kinuvo-subtle); border: 1px dashed var(--sl-color-gray-5); white-space: nowrap; }
  .k-soon.k-start { color: var(--sl-color-accent-high); background: var(--sl-color-accent-low); border: 1px solid color-mix(in srgb, var(--kinuvo-accent) 40%, transparent); }
  .k-first { border-color: color-mix(in srgb, var(--kinuvo-accent) 45%, var(--sl-color-hairline)); }
  .k-app strong { font-family: Libron, Georgia, serif; font-size: 1.25rem; color: var(--sl-color-white); }
  .k-app-detail { flex: 1; font-size: .9rem; line-height: 1.5; color: var(--sl-color-gray-2); }
  .k-app-foot { display: flex; align-items: center; justify-content: space-between; margin-top: .7rem; padding-top: .75rem; border-top: 1px solid var(--sl-color-hairline); }
  .k-cta { font-size: .88rem; font-weight: 600; color: var(--sl-color-accent-high); }
  .k-cta span { display: inline-block; transition: transform .2s; }
  .k-app:hover .k-cta span { transform: translateX(3px); }
  .k-logos { display: flex; flex-wrap: nowrap; align-items: center; gap: .45rem; }
  .k-logos svg { display: block; flex-shrink: 0; width: .95rem; height: .95rem; margin: 0; fill: var(--sl-color-gray-3); }
  .k-small { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; margin: .9rem 0 0; font-size: .85rem; color: var(--sl-color-gray-3); }
  .k-small a { color: var(--sl-color-accent-high); }

  /* The standalone Server is an optional extra, not a numbered step. */
  .k-optional { margin: 0 0 2rem calc(2.5rem + clamp(1rem, 3vw, 1.75rem)); padding: 1.2rem 1.4rem; border-radius: 18px; border: 1.5px dashed var(--sl-color-gray-5); }
  .k-tag { display: inline-block; margin-bottom: .5rem; padding: .15rem .6rem; border-radius: 999px; background: var(--kinuvo-subtle); color: var(--sl-color-gray-2); font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .k-optional h3 { margin: 0; font-size: 1.35rem; letter-spacing: -.02em; }
  .k-optional > p { margin: .4rem 0 1rem; max-width: 60ch; color: var(--sl-color-gray-2); line-height: 1.6; }

  /* The Agent picked on the landing page waits at the end. */
  .k-done {
    display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap;
    margin-left: calc(2.5rem + clamp(1rem, 3vw, 1.75rem)); padding: 1.1rem 1.4rem; border-radius: 22px;
    background: linear-gradient(120deg, color-mix(in srgb, var(--kinuvo-accent) 16%, var(--kinuvo-panel)), var(--kinuvo-panel) 70%);
    border: 1px solid color-mix(in srgb, var(--kinuvo-accent) 30%, var(--sl-color-hairline));
  }
  .k-me { width: 4rem; height: 4rem; flex-shrink: 0; }
  .k-me :global(kinuvo-avatar) { width: 100%; height: 100%; }
  .k-done p { flex: 1; min-width: 12rem; margin: 0; font-size: 1.05rem; color: var(--sl-color-gray-2); }
  .k-done strong { color: var(--sl-color-white); }
  .k-go { padding: .7rem 1.1rem; border-radius: 12px; font-weight: 600; text-decoration: none; white-space: nowrap; background: var(--kinuvo-accent); color: var(--agent-on, #fff); transition: transform .2s; }
  .k-go:hover { transform: translateY(-2px); }

  @media (max-width: 40rem) {
    .k-apps { grid-template-columns: 1fr; }
    .k-steps > li { grid-template-columns: 2rem minmax(0, 1fr); }
    .k-num { width: 2rem; height: 2rem; font-size: .9rem; }
    .k-steps > li::before { left: calc(1rem - 1px); top: 2.4rem; }
    .k-done, .k-optional { margin-left: 0; }
    .k-go { width: 100%; text-align: center; }
  }
</style>
