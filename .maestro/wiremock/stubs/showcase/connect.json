{
  "name": "showcase/connect",
  "priority": 1,
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "connect"
        }
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"token\":\"e2e-token\",\"serverName\":\"Showcase Server\",\"management\":true,\"capabilities\":{\"serverId\":\"e2e-server\",\"features\":[\"Attachments\",\"Skills\",\"Knowledge\",\"Tasks\",\"Routines\",\"Screens\",\"Computer\",\"Browser\"]},\"protocolVersion\":5,\"deviceId\":\"e2e-device\"}}"
        }
      }
    }
  ]
}
