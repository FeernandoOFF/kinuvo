        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"event\",\"event\":\"session.update\",\"payload\":{\"agentId\":\"e2e\",\"sessionId\":\"rich\",\"change\":{\"type\":\"entry\",\"seq\":6,\"entry\":{\"type\":\"tool_result\",\"id\":\"t-fetch\",\"name\":\"web_fetch\",\"output\":\"Request failed: 503 Service Unavailable\",\"isError\":true}}},\"seq\":8}"
        }
      }
    },
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"event\",\"event\":\"session.update\",\"payload\":{\"agentId\":\"e2e\",\"sessionId\":\"rich\",\"change\":{\"type\":\"entry\",\"seq\":7,\"entry\":{\"type\":\"tool_call\",\"id\":\"t-push\",\"name\":\"shell\",\"args\":\"{\\\"command\\\": \\\"git push origin release/2.0\\\"}\"}}},\"seq\":9}"
        }
      }
    },
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"event\",\"event\":\"session.update\",\"payload\":{\"agentId\":\"e2e\",\"sessionId\":\"rich\",\"change\":{\"type\":\"entry\",\"seq\":8,\"entry\":{\"type\":\"tool_result\",\"id\":\"t-push\",\"name\":\"shell\",\"output\":\"The user denied this call. Note: Don't push yet\",\"isError\":true}}},\"seq\":10}"
        }
      }
    },
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"event\",\"event\":\"session.update\",\"payload\":{\"agentId\":\"e2e\",\"sessionId\":\"rich\",\"change\":{\"type\":\"entry\",\"seq\":9,\"entry\":{\"type\":\"assistant\",\"text\":\"### Migration guide\\n\\nUpgrading from 1.9 keeps every Session, Routine and Task. The first launch rebuilds the search index, which can take a few minutes on large Servers; the app stays usable while it runs.\\n\\nPaired Devices reconnect on their own. If a Device was offline for more than thirty days it asks to pair again, because its token expired. Nothing else changes for it.\\n\\nAgents keep their settings. Two settings moved: risk tolerance now lives under Rules, and the reasoning effort moved next to the model. Old values carry over.\\n\\nRoutines that ran on a fixed interval keep their schedule. Cron Routines are re-evaluated in the Server's time zone, so check any that ran at midnight.\\n\\nFinally, the CLI gained `kinuvo pair` and `kinuvo unpair`. Scripts that called the old `kinuvo devices add` keep working but print a deprecation notice.\\n\\nThat's everything for the notes. Want me to post the draft to the team channel, or keep it here while you review the table?\",\"messageId\":\"m-guide\"}}},\"seq\":11}"
        }
      }
    },
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"event\",\"event\":\"session.update\",\"payload\":{\"agentId\":\"e2e\",\"sessionId\":\"rich\",\"change\":{\"type\":\"entry\",\"seq\":10,\"entry\":{\"type\":\"user\",\"text\":\"Post it to the team channel.\"}}},\"seq\":12}"
        }
