{
  "name": "showcase/capabilities-rich",
  "priority": 1,
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "and": [
          {
            "matchesJsonPath": {
              "expression": "$.method",
              "equalTo": "session.capabilities"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.params.sessionId",
              "equalTo": "rich"
            }
          }
        ]
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"server\":{\"serverId\":\"e2e-server\",\"features\":[\"Attachments\",\"Browser\",\"Skills\"]}}}"
        }
      }
    }
  ]
}
