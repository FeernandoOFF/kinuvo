{
  "name": "showcase/computer-watch",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "screens.watch"
        }
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"id\":\"computer-sub\",\"epoch\":\"computer-epoch\"}}"
        }
      }
    },
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"event\",\"event\":\"screens.frame\",\"seq\":1,\"payload\":{\"screen\":{\"source\":\"computer\",\"id\":\"phone\"},\"subscription\":\"computer-sub\",\"epoch\":\"computer-epoch\",\"sequence\":1,\"sample\":{\"image\":\"\",\"width\":720,\"height\":1560,\"geometry\":\"fixture\"}}}"
        }
      }
    }
  ],
  "priority": 2
}
