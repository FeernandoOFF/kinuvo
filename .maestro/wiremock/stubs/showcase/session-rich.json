{
  "name": "showcase/session-rich",
  "priority": 1,
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "and": [
          {
            "matchesJsonPath": {
              "expression": "$.method",
              "equalTo": "session.get"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.params.sessionId",
              "equalTo": "rich"
            }
          }
        ]
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"id\":\"rich\",\"agentId\":\"e2e\",\"title\":\"Release notes review for the 2.0 launch, with the changelog and migration guide\",\"status\":\"Waiting\",\"favorite\":true,\"createdAt\":{{now offset='-3 minutes' format='epoch'}} }}"
        }
      }
    }
  ]
}
