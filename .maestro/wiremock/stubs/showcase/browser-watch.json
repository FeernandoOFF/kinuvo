{
  "name": "showcase/browser-watch",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "and": [
          {
            "matchesJsonPath": {
              "expression": "$.method",
              "equalTo": "screens.watch"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.params.screen.id",
              "equalTo": "tab-docs"
            }
          }
        ]
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"id\":\"browser-sub\",\"epoch\":\"browser-epoch\"}}"
        }
      }
    },
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"event\",\"event\":\"screens.frame\",\"seq\":1,\"payload\":{\"screen\":{\"source\":\"browser\",\"id\":\"tab-docs\",\"owner\":{\"agentId\":\"e2e\",\"sessionId\":\"rich\"}},\"subscription\":\"browser-sub\",\"epoch\":\"browser-epoch\",\"sequence\":1,\"sample\":{\"image\":\"\",\"width\":720,\"height\":1280,\"geometry\":\"fixture\"}}}"
        }
      }
    }
  ],
  "priority": 1
}
