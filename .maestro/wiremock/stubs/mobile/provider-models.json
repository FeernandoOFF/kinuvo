{
  "name": "mobile/provider-models",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "models.list"
        }
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"providers\":[{\"id\":\"hosted-models\",\"name\":\"Hosted models\",\"models\":[{\"id\":\"demo-model\",\"name\":\"Demo model\",\"reasoning\":[]}]},{\"id\":\"local-models\",\"name\":\"Local models\",\"models\":[{\"id\":\"demo-model\",\"name\":\"Demo model\",\"reasoning\":[]}]},{\"id\":\"codex\",\"name\":\"ChatGPT / Codex\",\"models\":[{\"id\":\"e2e-model\",\"name\":\"Demo model\",\"reasoning\":[]}]}]}}"
        }
      }
    }
  ]
}
