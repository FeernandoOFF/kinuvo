{
  "name": "mobile/room-session-new",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "and": [
          {
            "matchesJsonPath": {
              "expression": "$.method",
              "equalTo": "rooms.session"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.params.sessionId",
              "equalTo": "room-new"
            }
          }
        ]
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"session\":{\"id\":\"room-new\",\"roomId\":\"team\",\"title\":\"New Session\",\"messages\":[]},\"members\":{\"e2e\":{\"server\":{\"serverId\":\"e2e-server\",\"features\":[\"Tasks\",\"Knowledge\",\"Artifacts\",\"Routines\",\"Computer\",\"Shell\"],\"integrations\":{\"Exec\":[\"host\"]}},\"effective\":{\"provider\":\"codex\",\"model\":\"e2e-model\",\"reasoning\":\"medium\",\"approvals\":\"default\",\"exec\":\"host\",\"workspace\":[\"/tmp\"],\"container\":{},\"ssh\":null,\"tools\":[\"shell\",\"files\"]}}}}}"
        }
      }
    }
  ]
}
