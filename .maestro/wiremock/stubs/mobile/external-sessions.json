{
  "name": "mobile/external-sessions",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "sessions.list"
        }
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"sessions\":[{\"id\":\"e2e-session\",\"agentId\":\"e2e\",\"title\":\"External regression\",\"status\":\"Idle\",\"createdAt\":1793318400000}],\"hasMore\":false}}"
        }
      }
    }
  ]
}
