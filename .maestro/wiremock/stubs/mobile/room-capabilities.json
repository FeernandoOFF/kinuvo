{
  "name": "mobile/room-capabilities",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "session.capabilities"
        }
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"server\":{\"serverId\":\"e2e-server\",\"features\":[\"Tasks\",\"Knowledge\",\"Artifacts\",\"Routines\",\"Computer\",\"Shell\"],\"integrations\":{\"Exec\":[\"host\"]}},\"effective\":{\"provider\":\"codex\",\"model\":\"e2e-model\",\"reasoning\":\"medium\",\"approvals\":\"default\",\"exec\":\"host\",\"workspace\":[\"/tmp\"],\"container\":{},\"ssh\":null,\"tools\":[\"shell\",\"files\"]}}}"
        }
      }
    }
  ]
}
