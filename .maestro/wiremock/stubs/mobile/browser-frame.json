{
  "name": "mobile/browser-frame",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "and": [
          {
            "matchesJsonPath": {
              "expression": "$.method",
              "equalTo": "browser.command"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.params.action",
              "equalTo": "Capture"
            }
          }
        ]
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"tab\":{\"id\":\"browser-tab\",\"agentId\":\"e2e\",\"sessionId\":\"e2e-session\",\"title\":\"Private site\",\"url\":\"http://lab.internal\",\"takeover\":false,\"thumbnail\":\"\"},\"revision\":\"r1\",\"screenshot\":\"\",\"width\":128,\"height\":80}}"
        }
      }
    }
  ]
}
