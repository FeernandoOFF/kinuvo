{
  "name": "mobile/computers",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "screens.list"
        }
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":[{\"ref\":{\"source\":\"computer\",\"id\":\"phone\"},\"title\":\"Pixel\",\"status\":\"Ready\",\"active\":false,\"capabilities\":{\"delivery\":\"Continuous\",\"inputs\":[\"tap\",\"type\",\"key\",\"scroll\"],\"keys\":[\"Back\",\"Home\",\"Recents\"]},\"control\":{\"generation\":0}}]}"
        }
      }
    }
  ]
}