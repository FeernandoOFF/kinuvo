{
  "name": "mobile/room-sessions",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "rooms.sessions"
        }
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":[{\"id\":\"room-session\",\"roomId\":\"team\",\"messages\":[{\"id\":\"user\",\"text\":\"Plan the garden\",\"senderName\":\"You\",\"recipients\":[\"e2e\"]},{\"id\":\"reply\",\"sender\":\"builder\",\"senderName\":\"Builder\",\"text\":\"The materials list is ready.\",\"rootId\":\"user\",\"replyTo\":\"user\"}]}]}"
        }
      }
    }
  ]
}
