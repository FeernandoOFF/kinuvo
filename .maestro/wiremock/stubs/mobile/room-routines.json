{
  "name": "mobile/room-routines",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "routines.list"
        }
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":[{\"id\":\"garden-check\",\"agentId\":\"e2e\",\"name\":\"Garden check\",\"prompt\":\"Check the garden plan\",\"trigger\":{\"type\":\"every\",\"minutes\":60},\"timeZone\":\"Europe/Dublin\",\"lastStatus\":\"Ok\",\"lastRunAt\":1792684800000,\"nextRunAt\":1792688400000}]}"
        }
      }
    }
  ]
}
