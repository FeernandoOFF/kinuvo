{
  "name": "mobile/room-send",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "and": [
          {
            "matchesJsonPath": {
              "expression": "$.method",
              "equalTo": "rooms.send"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.params.recipients",
              "equalToJson": "[\"e2e\"]"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.params.text",
              "equalTo": "Check the plan"
            }
          }
        ]
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{}}"
        }
      }
    }
  ]
}
