{
  "name": "mobile/presence-active",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "and": [
          {
            "matchesJsonPath": {
              "expression": "$.method",
              "equalTo": "client.presence"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.params.active",
              "equalTo": "true"
            }
          }
        ]
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{}}"
        }
      }
    }
  ]
}
