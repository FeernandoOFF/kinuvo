{
  "name": "mobile/providers",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "providers.list"
        }
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":[{\"id\":\"hosted-models\",\"name\":\"Hosted models\",\"apiKey\":{\"configured\":false,\"storage\":\"Server keychain\",\"saved\":false}},{\"id\":\"local-models\",\"name\":\"Local models\"},{\"id\":\"codex\",\"name\":\"ChatGPT / Codex\",\"account\":{\"signedIn\":true}}]}"
        }
      }
    }
  ]
}
