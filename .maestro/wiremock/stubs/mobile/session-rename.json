{
  "name": "mobile/session-rename",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "and": [
          {
            "matchesJsonPath": {
              "expression": "$.method",
              "equalTo": "session.update"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.params.sessionId",
              "equalTo": "e2e-session"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.params.title",
              "equalTo": "Trip plans"
            }
          }
        ]
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"id\":\"e2e-session\",\"agentId\":\"e2e\",\"title\":\"Trip plans\",\"status\":\"Idle\",\"favorite\":true}}"
        }
      }
    }
  ]
}
