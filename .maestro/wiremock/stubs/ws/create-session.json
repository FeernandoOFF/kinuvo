{
  "name": "ws/create-session",
  "trigger": {
    "type": "message",
    "channel": {
      "type": "websocket",
      "initiatingRequestPattern": {
        "url": "/ws"
      }
    },
    "message": {
      "body": {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "session.create"
        }
      }
    }
  },
  "actions": [
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"res\",\"id\":\"{{jsonPath message.body '$.id'}}\",\"ok\":true,\"payload\":{\"id\":\"e2e-session\",\"agentId\":\"e2e\",\"title\":\"E2E chat\",\"status\":\"Idle\"}}"
        }
      }
    },
    {
      "type": "send",
      "channelTarget": {
        "type": "originating"
      },
      "message": {
        "body": {
          "data": "{\"type\":\"event\",\"event\":\"session.changed\",\"payload\":{\"id\":\"e2e-session\",\"agentId\":\"e2e\",\"title\":\"E2E chat\",\"status\":\"Idle\"},\"seq\":2}"
        }
      }
    }
  ]
}
