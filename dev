#!/bin/sh
set -eu
kinuvo_project_root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
. "$kinuvo_project_root/scripts/project-env.sh"
cd "$kinuvo_project_root"
command=${1:-help}
[ "$#" -eq 0 ] || shift
case "$command" in
    init)
        python3 - "$@" <<'INIT'
import sys
from pathlib import Path
if len(sys.argv) != 3:
    sys.exit("Usage: ./dev init /absolute/data/home <port>")
home, port = sys.argv[1:]
if not Path(home).is_absolute() or "\n" in home:
    sys.exit("The data home must be an absolute path on one line")
if not port.isascii() or not port.isdecimal() or not 1 <= int(port) <= 65535:
    sys.exit("The port must be a number from 1 to 65535")
if any(Path(name).exists() for name in [".kinuvo-home", ".kinuvo-port"]):
    sys.exit("Checkout already configured; refusing to overwrite its pins")
created = []
try:
    for name, value in [(".kinuvo-home", home), (".kinuvo-port", str(int(port)))]:
        with open(name, "x") as file:
            created.append(Path(name))
            file.write(value + "\n")
except BaseException:
    for path in created:
        path.unlink()
    raise
print("Pinned home:", home)
print("Pinned port:", port)
INIT
        exit ;;
    help|-h|--help)
        echo "Usage: ./dev {init /absolute/home port|home|server [flags]|desktop|android [flags]|ios [flags]|cli [args]|kotlin [args]|exec command [args]}"
        exit ;;
esac
[ -f .kinuvo-home ] && [ -f .kinuvo-port ] || { echo "Run ./dev init /absolute/data/home <port> first" >&2; exit 1; }
case "$command" in
    server|desktop)
        python3 - "$KINUVO_HOME" <<'CHECK'
import json, os, sys
from pathlib import Path
record = Path(sys.argv[1]) / "server.json"
if record.exists():
    try:
        data = json.loads(record.read_text())
        pid = int(data["pid"])
        if pid <= 0:
            raise ValueError("invalid Server pid")
        os.kill(pid, 0)
    except ProcessLookupError:
        pass
    except PermissionError:
        sys.exit("Cannot verify the existing Server; refusing to start another against this home")
    except (ValueError, KeyError, OSError) as error:
        sys.exit(f"Cannot validate {record}: {error}")
    else:
        sys.exit(f"A Server (pid {pid}) already owns {sys.argv[1]}; use ./dev cli or stop it first")
CHECK
        ;;
esac
case "$command" in
    home) printf '%s\n' "$KINUVO_HOME" ;;
    server) exec ./kotlin run -m cli -- serve --host 127.0.0.1 --port "$(cat .kinuvo-port)" "$@" ;;
    desktop) exec ./kotlin run -m desktop "$@" ;;
    android) exec ./kotlin run -m android "$@" ;;
    ios) exec ./kotlin run -m ios "$@" ;;
    cli) exec ./kotlin run -m cli -- "$@" ;;
    kotlin) exec ./kotlin "$@" ;;
    exec) exec "$@" ;;
    *) echo "Unknown command; run ./dev help" >&2; exit 1 ;;
esac
