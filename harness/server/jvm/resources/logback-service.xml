<configuration>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${kinuvo.log.file}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${kinuvo.log.file}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>${kinuvo.log.maxFileSize:-10MB}</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%date{ISO8601} %-5level [%thread] %logger - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="${KINUVO_LOG_LEVEL:-INFO}">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
