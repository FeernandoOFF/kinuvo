      {"id":"subtotal","component":"Text","text":{"call":"formatCurrency","args":{"value":{"call":"sum","args":{"values":{"path":"/items"},"fields":["qty","price"]}},"currency":"EUR","decimals":0}}},
      {"id":"tax","component":"Text","text":{"call":"formatCurrency","args":{"value":{"call":"multiply","args":{"values":[{"call":"sum","args":{"values":{"path":"/items"},"fields":["qty","price"]}},0.2]}},"currency":"EUR","decimals":0}}},
      {"id":"grand","component":"Text","text":{"call":"formatCurrency","args":{"value":{"call":"multiply","args":{"values":[{"call":"sum","args":{"values":{"path":"/items"},"fields":["qty","price"]}},1.2]}},"currency":"EUR","decimals":0}},"variant":"h2"},
      {"id":"terms","component":"Text","text":"Includes 20% VAT · thank you for your business","variant":"caption"},
      {"id":"sendInvoiceLabel","component":"Text","text":"Send invoice"},
      {"id":"sendInvoice","component":"Button","variant":"primary","child":"sendInvoiceLabel","action":{"event":{"name":"sendInvoice","context":{"data":{"path":"/"},"total":{"call":"formatCurrency","args":{"value":{"call":"multiply","args":{"values":[{"call":"sum","args":{"values":{"path":"/items"},"fields":["qty","price"]}},1.2]}},"currency":"EUR","decimals":0}}}}}},
      {"id":"subtotalRow","component":"Row","children":["subtotalLabel","subtotal"]},
      {"id":"subtotalLabel","component":"Text","text":"Subtotal","weight":1},
      {"id":"taxRow","component":"Row","children":["taxLabel","tax"]},
      {"id":"taxLabel","component":"Text","text":"VAT · 20%","weight":1},
      {"id":"grandRow","component":"Row","children":["grandLabel","grand"]},
      {"id":"grandLabel","component":"Text","text":"Total due","weight":1},
      {"id":"eyebrowRow","component":"Row","children":["exampleIcon","eyebrow"]},
      {"id":"exampleIcon","component":"Icon","name":"payment"}
    ],
    "dataModel": {"items":[{"description":"Design","qty":2,"price":150},{"description":"Build","qty":3,"price":200}]}
  }
