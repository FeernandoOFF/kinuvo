      {"id":"table","component":"Table","children":["head","items"]},
      {"id":"head","component":"TableRow","header":true,"children":["descH","qtyH","priceH","totalH"]},
      {"id":"descH","component":"TableCell","children":["descHText"]},
      {"id":"descHText","component":"Text","text":"Item"},
      {"id":"qtyH","component":"TableCell","children":["qtyHText"]},
      {"id":"qtyHText","component":"Text","text":"Qty"},
      {"id":"priceH","component":"TableCell","children":["priceHText"]},
      {"id":"priceHText","component":"Text","text":"Rate"},
      {"id":"totalH","component":"TableCell","children":["totalHText"]},
      {"id":"totalHText","component":"Text","text":"Total"},
      {"id":"items","component":"Column","children":{"componentId":"item","path":"/items"}},
      {"id":"item","component":"TableRow","children":["descC","qtyC","priceC","totalC"]},
      {"id":"descC","component":"TableCell","children":["desc"]},
      {"id":"qtyC","component":"TableCell","children":["qty"]},
      {"id":"priceC","component":"TableCell","children":["price"]},
      {"id":"totalC","component":"TableCell","children":["lineTotal"]},
      {"id":"desc","component":"TextField","value":{"path":"description"}},
      {"id":"qty","component":"Stepper","value":{"path":"qty"},"step":1,"min":1,"max":99},
      {"id":"price","component":"TextField","value":{"path":"price"},"variant":"number"},
