{
  "version": "v1.0",
  "createSurface": {
    "surfaceId": "example-invoice-builder",
    "catalogId": "https://kinuvo.com/a2ui/v1/catalog.json",
    "components": [
      {"id":"root","component":"Card","child":"body"},
      {"id":"body","component":"Column","children":["eyebrowRow","heading","divider","status","table","subtotalRow","taxRow","grandRow","terms","sendInvoice"]},
      {"id":"eyebrow","component":"Text","text":"STUDIO NORTH → ACME","variant":"caption"},
      {"id":"heading","component":"Text","text":"Invoice #042","variant":"h1"},
      {"id":"divider","component":"Divider"},
