{
  "version": "v1.0",
  "createSurface": {
    "surfaceId": "example-trip-budget",
    "catalogId": "https://kinuvo.com/a2ui/v1/catalog.json",
    "components": [
      {"id":"root","component":"Card","child":"body"},
      {"id":"body","component":"Column","children":["eyebrowRow","heading","divider","total","note","share","people","shareTrip"]},
      {"id":"eyebrow","component":"Text","text":"TRIP BUDGET · 3 FRIENDS","variant":"caption"},
      {"id":"heading","component":"Text","text":"Lisbon, together","variant":"h1"},
      {"id":"divider","component":"Divider"},
      {"id":"total","component":"Text","text":{"call":"formatString","args":{"value":"€${formatNumber(value: sum(/expenses), decimals: 2)} spent"}},"variant":"h2"},
      {"id":"note","component":"Text","text":"Apartment, dinner & airport rides","variant":"caption"},
      {"id":"people","component":"Column","children":["receivers","payers"]},
      {"id":"person","component":"Column","children":["personHead","expense","paid"]},
      {"id":"personHead","component":"Row","children":["name"]},
      {"id":"name","component":"Text","text":{"path":"name"},"variant":"h3"},
      {"id":"share","component":"Badge","label":"€100.00 each"},
      {"id":"paid","component":"Text","text":{"call":"formatString","args":{"value":"Paid €${formatNumber(value: sum(paid), decimals: 2)}"}}},
      {"id":"receivers","component":"Column","children":{"componentId":"receiversPerson","path":"/receivers"}},
      {"id":"receiversPerson","component":"Column","children":["person","receiversSettlement"]},
      {"id":"receiversSettlement","component":"Badge","label":{"call":"formatString","args":{"value":"${settlement} €${formatNumber(value:${balance}, decimals:2)}"}},"color":"success"},
      {"id":"payers","component":"Column","children":{"componentId":"payersPerson","path":"/payers"}},
      {"id":"payersPerson","component":"Column","children":["person","payersSettlement"]},
      {"id":"payersSettlement","component":"Badge","label":{"call":"formatString","args":{"value":"${settlement} €${formatNumber(value:${balance}, decimals:2)}"}},"color":"danger"},
      {"id":"shareTripLabel","component":"Text","text":"Share settlement"},
      {"id":"shareTrip","component":"Button","variant":"primary","child":"shareTripLabel","action":{"event":{"name":"shareTrip","context":{"data":{"path":"/"}}}}},
      {"id":"eyebrowRow","component":"Row","children":["exampleIcon","eyebrow"]},
      {"id":"exampleIcon","component":"Icon","name":"locationOn"},
      {"id":"expense","component":"Text","text":{"path":"expense"},"variant":"caption"}
    ],
    "dataModel": {"expenses":[120,45,90,45],"receivers":[{"name":"Alex","paid":[120,45],"expense":"Apartment & groceries","settlement":"Receives","balance":65}],"payers":[{"name":"Sam","paid":[90],"expense":"Dinner for three","settlement":"Pays","balance":10},{"name":"Jo","paid":[45],"expense":"Airport rides","settlement":"Pays","balance":55}]}
  }
}
