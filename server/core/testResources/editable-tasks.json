{
  "version": "v1.0",
  "createSurface": {
    "surfaceId": "editable-tasks",
    "catalogId": "https://kinuvo.com/a2ui/v1/catalog.json",
    "components": [
      {"id":"root","component":"Card","child":"body"},
      {"id":"body","component":"Column","children":["heading","table","footer","submit"]},
      {"id":"title","component":"Text","text":"Tasks","variant":"h3"},
      {"id":"addLabel","component":"Text","text":"+ Add row"},
      {"id":"add","component":"Button","child":"addLabel","action":{"functionCall":{"call":"append","args":{"path":"/rows","value":{"task":"","status":["Todo"],"priority":["Medium"]}}}},"variant":"borderless"},
      {"id":"table","component":"Table","children":["header","rows"]},
      {"id":"header","component":"TableRow","header":true,"children":["hTask","hStatus","hPriority","hRemove"]},
      {"id":"hTaskText","component":"Text","text":"Task"},
      {"id":"hTask","component":"TableCell","children":["hTaskText"]},
      {"id":"hStatusText","component":"Text","text":"Status"},
      {"id":"hStatus","component":"TableCell","children":["hStatusText"]},
      {"id":"hPriorityText","component":"Text","text":"Priority"},
      {"id":"hPriority","component":"TableCell","children":["hPriorityText"]},
      {"id":"hRemoveText","component":"Text","text":""},
      {"id":"hRemove","component":"TableCell","children":["hRemoveText"]},
      {"id":"rows","component":"Column","children":{"componentId":"row","path":"/rows"}},
      {"id":"row","component":"TableRow","children":["taskCell","statusCell","priorityCell","removeCell"]},
      {"id":"taskCell","component":"TableCell","children":["task"]},
      {"id":"statusCell","component":"TableCell","children":["status"]},
      {"id":"priorityCell","component":"TableCell","children":["priority"]},
      {"id":"removeCell","component":"TableCell","children":["remove"]},
      {"id":"task","component":"TextField","value":{"path":"task"},"placeholder":"Task name"},
      {"id":"status","component":"ChoicePicker","value":{"path":"status"},"displayStyle":"dropdown","options":[{"value":"Todo","label":"Todo"},{"value":"In progress","label":"In progress"},{"value":"Done","label":"Done"}]},
      {"id":"priority","component":"ChoicePicker","value":{"path":"priority"},"displayStyle":"dropdown","options":[{"value":"Low","label":"Low"},{"value":"Medium","label":"Medium"},{"value":"High","label":"High"}]},
      {"id":"removeLabel","component":"Icon","name":"delete"},
      {"id":"remove","component":"Button","child":"removeLabel","action":{"functionCall":{"call":"removeAt","args":{}}},"variant":"borderless"},
      {"id":"footer","component":"Row","children":["counts","footerSpace","copy"]},
      {"id":"copyLabel","component":"Text","text":"Copy table"},
      {"id":"copy","component":"Button","child":"copyLabel","action":{"functionCall":{"call":"copy","args":{"path":"/rows"}}},"variant":"borderless"},
      {"id":"submitLabel","component":"Text","text":"Send"},
      {"id":"submit","component":"Button","child":"submitLabel","action":{"event":{"name":"submitTasks","context":{"rows":{"path":"/rows"}}}},"variant":"primary"},
      {"id":"heading","component":"Row","children":["title","space","add"]},
      {"id":"space","component":"Spacer","weight":1},
      {"id":"counts","component":"Text","text":{"call":"formatString","args":{"value":"${count(/rows)} tasks · ${count(/rows, {\"status\":\"Done\"})} completed"}},"variant":"caption"},
      {"id":"footerSpace","component":"Spacer","weight":1}
    ],
    "dataModel": {"rows":[{"task":"Plan launch","status":["Done"],"priority":["High"]},{"task":"Review designs","status":["Todo"],"priority":["Medium"]},{"task":"Write docs","status":["In progress"],"priority":["Low"]},{"task":"Ship update","status":["Todo"],"priority":["High"]}]}
  }
}
